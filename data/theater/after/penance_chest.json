					"zone": "sole",
					"fx": "lines",
					"repeat": 14,
					"interval": 0.12,
					"do": "tickle"
				}
			]
		},
		{
			"speaker": "公主",
			"text": "脱、脱下来了……！哈……哈……袜子还在地上笑……",
			"emotion": "helpless_1"
		},
		{
			"speaker": "",
			"text": "（第三件：一条旧的潜行短裤。小牌子上没写从谁那里收来的，只写着：「最后一件。不要穿。」）",
			"act": 3
		},
		{
			"speaker": "公主",
			"text": "……写得这么吓人。越写不要，越想试。",
			"emotion": "question"
		},
		{
			"speaker": "",
			"text": "（她套上短裤。里面一层软软的衬里——不对，是十几只小小的布手，整整齐齐地缝在里面。它们一起，轻轻地，握了握她的大腿）",
