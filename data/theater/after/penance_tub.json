					"interval": 0.14,
					"do": "tickle"
				}
			]
		},
		{
			"speaker": "公主",
			"text": "这个桶……是专门让人站不起来的吧……哈哈哈……！",
			"emotion": "helpless_1"
		},
		{
			"speaker": "",
			"text": "（桶壁上贴着一张泡皱了的小纸条：「站起来一次，刷子快一点」）"
		},
		{
			"speaker": "公主",
			"text": "……又是这种规矩！这里的东西，全都是一个人做的吧！",
			"emotion": "helpless_1"
		},
		{
			"speaker": "",
			"text": "（她不敢站了。可是坐着不动，泡泡就专挑大腿根冒，刷子就专挑脚心转）",
			"actions": [
				{
					"who": "princess",
					"by": "tub",
					"zone": "sole",
					"fx": "brush",
					"repeat": 12,
					"interval": 0.13,
					"do": "tickle"
				},
				{
					"who": "princess",
					"by": "tub",
					"zone": "thigh",
					"fx": "lines",
					"repeat": 12,
					"interval": 0.13,
					"do": "tickle"
				}
			]
		},
		{
			"speaker": "公主",
			"text": "站也不行……坐也不行……那我到底该怎么样啊……哈哈哈！",
			"emotion": "helpless_1"
		},
		{
			"speaker": "",
			"text": "（刷子越转越快。泡泡钻进脚趾缝里「啵、啵」地破，大腿根下面的那排冒泡口一阵一阵地喷）",
			"actions": [
				{
					"who": "princess",
					"by": "tub",
					"zone": "sole",
					"fx": "brush",
					"repeat": 16,
					"interval": 0.1,
					"do": "tickle"
				},
				{
					"who": "princess",
					"by": "tub",
					"zone": "thigh",
					"fx": "lines",
					"repeat": 16,
					"interval": 0.1,
					"do": "tickle"
				},
				{
					"who": "princess",
					"visual": "helpless_2",
					"do": "pose"
				}
			]
		},
		{
			"speaker": "公主",
			"text": "哈哈哈哈！脑、脑子洗干净了！洗得一干二净了！放我出去——哈哈哈！",
			"emotion": "helpless_2"
		},
		{
			"speaker": "公主",
			"text": "我、我认错——不对，我不认错——哈哈哈，我也不知道了——！",
			"emotion": "helpless_2"
		},
		{
			"speaker": "",
			"text": "（热水、泡泡、刷子，一起往上涌的还有魔力——）",
			"actions": [
				{
					"who": "princess",
					"by": "tub",
					"zone": "sole",
					"fx": "brush",
					"repeat": 12,
					"interval": 0.1,
					"do": "tickle"
				}
			]
		},
		{
			"speaker": "公主",
			"text": "（星光在水面上炸开，热水「哗」地溅了满地……哈啊……哈……暖暖的……全放出去了……好舒服……）",
			"actions": [
				{
					"time": 0.5,
					"do": "flash"
				},
				{
					"sound": "star_burst",
					"do": "sfx"
				},
				{
					"sound": "water_release",
					"volume": -2.0,
					"do": "sfx"
				},
				{
					"who": "princess",
					"time": 0.4,
					"do": "shake"
				},
				{
					"state": "laugh",
					"do": "voice"
				}
			],
			"act": "burst",
			"wait": 1.0
		},
		{
			"speaker": "",
			"text": "（木桶「咕嘟」一声，又冒出一大串泡泡。刚释放完的身体泡在热水里，每一颗泡泡破掉都像有人在挠）",
			"actions": [
				{
					"who": "princess",
					"by": "tub",
					"zone": "sole",
					"fx": "lines",
					"repeat": 12,
					"interval": 0.13,
					"do": "tickle"
				},
				{
					"who": "princess",
					"visual": "helpless_2",
					"do": "pose"
				}
			],
			"act": 4
		},
		{
			"speaker": "公主",
			"text": "……泡、泡泡也……一颗一颗地……哈哈……！",
			"emotion": "helpless_2"
		},
		{
			"speaker": "",
			"text": "（软刷又贴着脚心转了一圈，慢慢的，像是在给她擦干净）",
			"actions": [
				{
					"who": "princess",
					"by": "tub",
					"zone": "sole",
					"fx": "brush",
					"repeat": 10,
					"interval": 0.16,
					"do": "tickle"
				},
				{
					"who": "princess",
					"by": "tub",
					"zone": "thigh",
					"fx": "lines",
					"repeat": 8,
					"interval": 0.16,
					"do": "tickle"
				},
				{
					"do": "pose",
					"who": "princess",
					"visual": "helpless_2"
				}
			]
		},
		{
			"speaker": "公主",
			"text": "哈哈……哈……慢、慢慢的更……不要擦了……我自己擦……！",
			"emotion": "helpless_2"
		},
		{
			"speaker": "",
			"text": "（水终于凉了。泡泡停了，刷子也停了。她趴在桶边，湿淋淋地喘着气）",
			"actions": [
				{
					"who": "princess",
					"visual": "helpless_1",
					"do": "pose"
				}
			]
		},
		{
			"speaker": "公主",
			"text": "……洗洗脑子……洗得我……脑子里全是泡泡……",
			"emotion": "helpless_1"
		},
		{
			"speaker": "公主",
			"text": "……我才不会认错。……可是衣服要晾一晾。",
			"emotion": "sad"
		},
		{
			"actions": [
				{
					"state": "",
