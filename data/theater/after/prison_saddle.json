				{
					"who": "guard",
					"time": 0.4,
					"do": "shake"
				}
			]
		},
		{
			"speaker": "",
			"text": "（可马凳还没有坏。炸成毛球的刷子抖了抖，又慢慢转了起来——这一次，贴上的是刚放完魔力、敏感得发烫的脚心）",
			"actions": [
				{
					"who": "princess",
					"by": "saddle",
					"zone": "sole",
					"fx": "feather",
					"repeat": 10,
					"interval": 0.16,
					"do": "tickle"
				},
				{
					"who": "princess",
					"visual": "helpless_2",
					"do": "pose"
				}
			],
			"act": 4
		},
		{
			"speaker": "公主",
			"text": "（呀……！放、放完以后……轻轻刷一下……就……比刚才痒好几倍……！）",
			"emotion": "helpless_2"
		},
		{
			"speaker": "",
			"text": "（毛茸茸的刷子在脚心正中央打着圈，又钻进每一道趾缝里轻轻地挠。她整个人缩在凳子上抖，眼泪都憋出来了）",
			"actions": [
				{
					"who": "princess",
					"by": "saddle",
					"zone": "sole",
					"fx": "feather",
					"repeat": 14,
					"interval": 0.13,
					"do": "tickle"
				}
			]
		},
		{
			"speaker": "公主",
			"text": "……噗……哈……哈哈……不、不行……！",
			"actions": [
				{
					"who": "princess",
					"kind": "laugh",
					"do": "bubble"
				}
			]
		},
		{
			"speaker": "保卫队员",
			"text": "……黑、黑暗里有人在笑……！？地牢里……闹、闹鬼了——！",
			"actions": [
				{
					"who": "guard",
					"to": [
						90,
						4
					],
					"time": 0.5,
					"do": "move"
				}
			]
		},
		{
			"speaker": "",
			"text": "（守卫丢下灯，头也不回地跑了。刷子又转了好一会儿，才「咔」地停住，扣环也松开了）",
			"actions": [
				{
					"who": "princess",
					"visual": "helpless_1",
					"do": "pose"
				}
			]
		},
		{
			"speaker": "公主",
			"text": "……哈……哈……我、我说过……绝对不会再坐的……",
			"emotion": "helpless_1"
		},
		{
			"speaker": "公主",
			"text": "……不过……守卫跑掉了。……就当是……作战成功吧……",
			"emotion": "sad"
