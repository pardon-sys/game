			"kind": "monster:rat",
			"at": [
				26,
				12
			],
			"dir": "left"
		}
	},
	"steps": [
		{
			"act": 1,
			"actions": [
				{
					"time": 0.5,
					"do": "fade_in"
				},
				{
					"state": "giggle",
					"do": "voice"
				}
			],
			"wait": 0.5
		},
		{
			"speaker": "",
			"text": "（她踮着脚，把牢门的插销一点一点拔出来。门刚开一条缝，挠痒鼠「嗖」地一下钻了出来）",
			"act": 1
		},
		{
			"speaker": "挠痒鼠",
			"text": "吱吱！自由啦！三天！整整三天！谢谢公主！"
		},
		{
			"speaker": "公主",
			"text": "嘘——小声点！好啦，快走吧。别让守卫看见你。",
			"emotion": "surprise"
		},
		{
			"speaker": "挠痒鼠",
			"text": "那可不行。挠痒鼠一族，有恩必报。……作为谢礼——"
		},
		{
			"speaker": "公主",
			"text": "谢、谢礼就不用了！真的不用！",
			"emotion": "surprise"
		},
		{
			"speaker": "",
			"text": "（挠痒鼠没走。它绕着她的脚转了一圈，胡子抖了抖，顺着裙摆爬了下去）",
			"actions": [
				{
					"who": "princess",
					"by": "rat",
					"zone": "sole",
					"fx": "hand",
					"repeat": 4,
					"interval": 0.3,
					"do": "tickle"
				}
			],
			"act": 2
		},
		{
			"speaker": "",
			"text": "（然后一头钻进了她的鞋里）",
			"actions": [
				{
					"who": "princess",
					"by": "rat",
					"zone": "sole",
					"fx": "hand",
					"repeat": 5,
					"interval": 0.25,
					"do": "tickle"
				}
			]
		},
		{
			"speaker": "公主",
			"text": "呀——！？出、出来！鞋里不行——！",
			"actions": [
				{
					"who": "princess",
					"visual": "giggle",
					"do": "pose"
				},
				{
					"who": "princess",
					"time": 0.4,
					"do": "shake"
				}
			]
		},
		{
			"speaker": "挠痒鼠",
			"text": "吱吱～关了三天，爪子都痒了～这就是谢礼～",
			"actions": [
				{
					"who": "princess",
					"by": "rat",
					"zone": "sole",
					"fx": "hand",
					"repeat": 10,
					"interval": 0.16,
					"do": "tickle"
				}
			]
		},
		{
			"speaker": "",
			"text": "（小爪子在鞋子里扒拉着，把她的袜子一点点扒到脚踝，毛茸茸的尾巴尖扫过光着的脚心）",
			"actions": [
				{
					"who": "princess",
					"by": "rat",
					"zone": "sole",
					"fx": "hand",
					"repeat": 12,
					"interval": 0.15,
					"do": "tickle"
				}
			]
		},
		{
			"speaker": "公主",
			"text": "噗……嗯嗯……！不、不行……这里是地牢……",
			"emotion": "giggle"
		},
		{
			"speaker": "",
			"text": "（她想把鞋脱下来抖，可是一弯腰，挠痒鼠就顺着脚跟爬到了足弓，在最软的那一道上来回刨）",
			"actions": [
				{
					"who": "princess",
					"by": "rat",
					"zone": "sole",
					"fx": "hand",
					"repeat": 12,
					"interval": 0.14,
					"do": "tickle"
				}
			],
			"act": 3
		},
		{
			"speaker": "公主",
			"text": "噗……嗯嗯嗯……！（她死死捂住嘴，蹲在牢门边上发抖）",
			"actions": [
				{
					"who": "princess",
					"visual": "helpless_1",
					"do": "pose"
				},
				{
					"do": "voice",
					"state": "laugh"
				}
			],
			"emotion": "helpless_1"
		},
		{
			"speaker": "",
			"text": "（爪子又钻进了脚趾缝，一道一道地刨过去。走廊尽头，守卫的脚步声近了又远）",
			"actions": [
				{
					"who": "princess",
					"by": "rat",
					"zone": "sole",
					"fx": "hand",
					"repeat": 12,
					"interval": 0.14,
					"do": "tickle"
				}
			]
		},
		{
			"speaker": "挠痒鼠",
			"text": "吱？……吱吱！公主的脚趾缝好香，是面包的味道～"
		},
		{
			"speaker": "公主",
			"text": "才、才没有……那是晚饭的时候……哈……哈……别闻了……！",
			"emotion": "helpless_2"
		},
		{
			"speaker": "挠痒鼠",
			"text": "到底是哪一道最香呢？吱～挠痒鼠的鼻子，一道一道闻过去就知道了～"
		},
		{
			"speaker": "",
			"text": "（它扒开她的大脚趾和第二根脚趾，把尖尖的小鼻子凑进去嗅了嗅，又伸出小舌头飞快地舔了一下）",
			"actions": [
				{
					"who": "princess",
					"by": "rat",
					"zone": "sole",
					"fx": "hand",
					"repeat": 8,
					"interval": 0.16,
					"do": "tickle"
				}
			]
		},
		{
			"speaker": "公主",
			"text": "呀……！舔、舔了……！不许舔……！",
			"actions": [
				{
					"who": "princess",
					"time": 0.4,
					"do": "shake"
				}
			]
		},
		{
			"speaker": "挠痒鼠",
			"text": "唔……这一道是麦子味。下一道！",
			"actions": [
				{
					"who": "princess",
					"by": "rat",
					"zone": "sole",
					"fx": "hand",
					"repeat": 6,
					"interval": 0.18,
					"do": "tickle"
				}
			]
		},
		{
			"speaker": "",
			"text": "（第二道、第三道……它一道一道地钻进去，嗅一嗅、舔一舔，胡子扫得她整只脚都在抖）",
			"actions": [
				{
					"who": "princess",
					"by": "rat",
					"zone": "sole",
					"fx": "hand",
					"repeat": 12,
					"interval": 0.13,
					"do": "tickle"
				}
			]
		},
		{
			"speaker": "公主",
			"text": "哈……哈……不、不要一道一道来……每一道都……好痒……！嗯嗯嗯……！",
			"emotion": "helpless_2"
		},
		{
			"speaker": "挠痒鼠",
			"text": "第四道有黄油味……可是还不够！最后一道——",
			"actions": [
				{
					"who": "princess",
					"by": "rat",
					"zone": "sole",
					"fx": "hand",
					"repeat": 6,
					"interval": 0.18,
					"do": "tickle"
				}
			]
		},
		{
			"speaker": "",
			"text": "（它钻到小脚趾和第四根脚趾中间那一道，最窄、最软的地方，舔了一下，又舔了一下，满意地「吱」了一声）",
			"actions": [
				{
					"who": "princess",
					"by": "rat",
					"zone": "sole",
					"fx": "hand",
					"repeat": 12,
					"interval": 0.12,
					"do": "tickle"
				}
			]
		},
		{
			"speaker": "挠痒鼠",
			"text": "找到了！这一道最香！是刚出炉的面包！再闻十下！"
		},
		{
			"speaker": "公主",
			"text": "十、十下……！？不……那、那一道最怕痒……哈哈……求你了……！",
			"actions": [
				{
					"who": "princess",
					"kind": "laugh",
					"do": "bubble"
				}
			],
			"emotion": "helpless_2"
		},
		{
			"speaker": "",
			"text": "（小舌头在那道最窄的趾缝里来回舔，尾巴还在脚心上一下一下地扫。她蜷成一团缩在牢门边，捂着嘴的手都在抖）",
			"actions": [
				{
					"who": "princess",
					"by": "rat",
					"zone": "sole",
					"fx": "hand",
					"repeat": 14,
					"interval": 0.12,
					"do": "tickle"
				}
			]
		},
		{
			"speaker": "",
			"text": "（挠痒鼠在她的小脚趾上咬了一口——不疼，只是痒得她整个人都弹了一下，差点撞上铁栏杆）",
			"actions": [
				{
					"who": "princess",
					"by": "rat",
					"zone": "sole",
					"fx": "hand",
					"repeat": 8,
					"interval": 0.16,
					"do": "tickle"
				},
				{
					"who": "princess",
					"time": 0.5,
					"do": "shake"
				}
			]
		},
		{
			"speaker": "公主",
			"text": "……求、求你了……出来……守卫会听见的……我请你吃面包……！",
			"emotion": "helpless_2"
		},
		{
			"speaker": "挠痒鼠",
			"text": "面包！吱吱！成交！",
			"act": 4
		},
		{
			"speaker": "",
			"text": "（挠痒鼠从鞋口钻出来，叼走了她口袋里半块面包，抖了抖胡子，一溜烟跑进了墙缝）",
			"actions": [
				{
					"who": "princess",
					"visual": "normal",
					"do": "pose"
				}
			]
		},
		{
			"speaker": "公主",
			"text": "……哈……哈……再、再也不随便放东西出来了……",
			"emotion": "sad"
		},
		{
			"speaker": "公主",
			"text": "……面包也没了。……呜。"
		},
		{
			"actions": [
				{
					"state": "",
					"do": "voice"
				},
				{
					"time": 0.6,
					"do": "fade_out"
				}
			],
			"wait": 0.7
		}
	]
}
