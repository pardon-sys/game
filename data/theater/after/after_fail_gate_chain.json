					"interval": 0.16,
					"do": "tickle"
				}
			]
		},
		{
			"speaker": "公主",
			"text": "哈哈哈哈！不是这个意思——！哈哈哈哈——！",
			"portrait": "defeat_2"
		},
		{
			"speaker": "",
			"text": "（被压着躲不开，脚趾蜷了又张、张了又蜷。痒意一层一层往上涌，魔力疲倦越积越满——）",
			"actions": [
				{
					"who": "princess",
