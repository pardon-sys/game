					"sound": "rumble",
					"volume": -2.0,
					"do": "sfx"
				}
			],
			"act": 2
		},
		{
			"speaker": "公主",
			"text": "诶！？堵、堵住了！？水在涨！",
			"emotion": "surprise"
		},
		{
			"speaker": "蓝色的公主",
			"text": "……出口。……在上面。"
		},
		{
			"speaker": "",
			"text": "（闸门上方很高的地方，有一道窄窄的缝，透出一点点光。光里飘着一股很旧很旧的、像是花香的味道）"
		},
		{
			"speaker": "挠脚鼠",
			"text": "（从短裤里探出头）吱吱！那上面！我闻到了，是很老很老的石头的味道——还有地毯！"
		},
		{
			"speaker": "公主",
			"text": "地毯？……这底下哪来的地毯？",
			"emotion": "question"
		},
		{
			"speaker": "",
			"text": "（水已经没过了膝盖。蓝色公主看了看那道缝，又看了看粉色公主）",
			"act": 3
		},
		{
			"speaker": "蓝色的公主",
			"text": "……踩我。……上去。"
		},
		{
			"speaker": "公主",
			"text": "诶？踩、踩你？",
			"emotion": "surprise"
		},
		{
			"speaker": "蓝色的公主",
			"text": "……快。"
		},
		{
			"speaker": "",
			"text": "（粉色公主踩着蓝色公主的肩膀往上爬。鼠爪鞋的肉垫软软地踩在肩上，挠脚鼠在短裤里一激动，又窜了一下）",
			"actions": [
				{
					"who": "princess",
					"by": "rat",
					"zone": "thigh",
					"fx": "hand",
					"repeat": 6,
