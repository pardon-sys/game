					"visual": "giggle",
					"do": "pose"
				}
			]
		},
		{
			"speaker": "公主",
			"text": "噫——！别、别在这时候——会掉下去的！",
			"emotion": "giggle"
		},
		{
			"speaker": "蓝色的公主",
			"text": "……肩、肩膀……肉垫……好痒……别乱动……"
		},
		{
			"speaker": "",
			"text": "（千手痒痒裤听见「痒」字，也跟着揉了一下。底下的人一抖，上面的人一晃——两个人笑着，一点一点地挪到了缝口）",
			"actions": [
				{
					"who": "blue",
					"by": "pants",
					"zone": "thigh",
					"fx": "hand",
					"repeat": 6,
					"interval": 0.15,
					"do": "tickle"
				}
			]
		},
		{
			"speaker": "公主",
			"text": "……抓、抓到了！来，手给我！",
			"emotion": "happy",
			"act": 4
		},
		{
			"speaker": "",
			"text": "（粉色公主趴在缝口，把蓝色公主拉了上来。两个人一起滚进了缝的另一头——）",
