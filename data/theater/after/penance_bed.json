					"who": "princess",
					"visual": "helpless_2",
					"do": "pose"
				}
			],
			"portrait": "penance_bed"
		},
		{
			"speaker": "公主",
			"text": "噗——哈哈哈哈！脚心！腰！一、一起来不行——哈哈哈哈！",
			"emotion": "helpless_2"
		},
		{
			"speaker": "",
			"text": "（她在床上扭来扭去，可脚踝被扣着，腰往左躲左边的刷子在等，往右躲右边的刷子在等）",
			"actions": [
				{
					"who": "princess",
					"by": "bed",
					"zone": "waist",
					"fx": "brush",
					"repeat": 14,
					"interval": 0.1,
					"do": "tickle"
