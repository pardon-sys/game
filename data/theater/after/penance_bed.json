					"fx": "feather",
					"repeat": 8,
					"interval": 0.2,
					"do": "tickle"
				},
				{
					"do": "pose",
					"who": "princess",
					"visual": "helpless_2"
				}
			],
			"act": 4
		},
		{
			"speaker": "公主",
			"text": "……一档……一档就……为什么一档就这么……！",
			"emotion": "helpless_2"
		},
		{
			"speaker": "",
			"text": "（刚释放完的脚心敏感得发烫，羽毛轻轻一扫，就像刚才四档那么痒）",
			"actions": [
				{
					"who": "princess",
					"by": "bed",
					"zone": "sole",
					"fx": "feather",
					"repeat": 14,
					"interval": 0.13,
					"do": "tickle"
