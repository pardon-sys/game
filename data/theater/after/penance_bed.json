			"act": 3
		},
		{
			"speaker": "公主",
			"text": "说明是反的——！？谁贴的——！！",
			"emotion": "surprise"
		},
		{
			"speaker": "",
			"text": "（「三档」「四档」一起来了。羽毛排刷扫着脚心和每一道趾缝，两把软刷贴着腰的两侧一圈一圈地揉）",
			"actions": [
				{
					"who": "princess",
					"by": "bed",
					"zone": "sole",
					"fx": "feather",
					"repeat": 16,
					"interval": 0.1,
