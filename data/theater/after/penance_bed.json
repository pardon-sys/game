					"visual": "giggle",
					"do": "pose"
				}
			],
			"act": 2
		},
		{
			"speaker": "公主",
			"text": "……嘻……嘻嘻……一档……还好……还好……",
			"emotion": "giggle"
		},
		{
			"speaker": "",
			"text": "（「二档」。床板轻轻一翻，把她翻成了趴着。羽毛排刷换了个方向，顺着大腿后侧，从膝盖窝一直刷到大腿根）",
			"actions": [
				{
					"who": "princess",
					"by": "bed",
					"zone": "thigh",
					"fx": "feather",
					"repeat": 12,
					"interval": 0.16,
					"do": "tickle"
				}
			]
		},
		{
			"speaker": "公主",
			"text": "翻、翻过来了！？大腿后面……那里我自己都没碰过……！",
			"emotion": "surprise"
		},
		{
			"speaker": "",
			"text": "（羽毛一根一根地从腿后面扫过去，扫到最上面，就在那一圈软软的地方打个转）",
			"actions": [
				{
