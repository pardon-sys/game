			],
			"act": "burst",
			"wait": 1.0
		},
		{
			"speaker": "公主",
			"text": "哈啊……魔力全放出去了……躺在刷毛上……软绵绵的……好舒服……",
			"emotion": "happy"
		},
		{
			"speaker": "",
			"text": "（攻城车晃了晃车灯，又咕噜咕噜地开了回来，车斗「哐」地一声重新扣住了她，剩下的刷子又转了起来）",
			"actions": [
				{
					"who": "cart",
					"to": [
						-30,
						10
					],
					"time": 0.6,
					"do": "move"
				},
				{
					"who": "princess",
					"by": "bucket",
					"zone": "sole",
					"fx": "lines",
					"repeat": 6,
					"interval": 0.2,
					"do": "tickle"
				}
			]
		},
		{
			"speaker": "公主",
			"text": "呀啊——！放、放完魔力……刷毛碰一下……就……比刚才痒好几倍——！",
			"actions": [
				{
					"who": "princess",
					"by": "bucket",
					"zone": "sole",
					"fx": "lines",
					"repeat": 8,
					"interval": 0.16,
					"do": "tickle"
				}
			],
			"emotion": "helpless_2"
		},
		{
			"speaker": "",
			"text": "（放空魔力的脚心敏感得发烫，连刷毛轻轻擦过都像被电了一下。她的脚背绷得笔直，十根脚趾张得开开的，躲都躲不开）",
			"actions": [
				{
					"who": "princess",
					"by": "bucket",
					"zone": "sole",
					"fx": "feather",
					"repeat": 12,
					"interval": 0.14,
					"do": "tickle"
				}
			]
		},
		{
			"speaker": "公主",
			"text": "哈哈哈哈！敏、敏感死了——车先生——求求你——我、我投降——我再也不拆你了——！",
			"actions": [
				{
					"who": "princess",
					"kind": "laugh",
					"do": "bubble"
				},
				{
					"who": "princess",
					"time": 0.6,
					"do": "shake"
				}
			]
		},
		{
			"speaker": "",
			"text": "（刷子听见「投降」两个字，转得更欢了，还多伸出一排软毛，在脚趾根上一下一下地点）",
			"actions": [
				{
					"who": "princess",
					"by": "bucket",
					"zone": "sole",
					"fx": "lines",
					"repeat": 10,
					"interval": 0.15,
					"do": "tickle"
				}
			]
		},
		{
			"speaker": "公主",
			"text": "点、点脚趾根是什么新花样——哈哈哈——这辆车……学坏了……！"
		},
		{
			"speaker": "",
			"text": "（攻城车慢悠悠地又绕了一圈，刷子一边转一边哼哼，像是在唱摇篮曲）",
			"actions": [
				{
					"who": "princess",
					"by": "bucket",
					"zone": "sole",
					"fx": "lines",
					"repeat": 10,
					"interval": 0.16,
					"do": "tickle"
				}
			]
		},
		{
			"speaker": "公主",
			"text": "哈……哈……摇、摇篮曲……这种时候……谁睡得着啊……哈哈……"
		},
		{
			"speaker": "",
			"text": "（她偷偷伸手去够车斗边，刷子立刻追过来，在脚心上扫了一个大大的圈）",
			"actions": [
				{
					"who": "princess",
					"by": "bucket",
					"zone": "sole",
					"fx": "feather",
					"repeat": 8,
					"interval": 0.16,
					"do": "tickle"
				}
			]
		},
		{
			"speaker": "公主",
			"text": "哈哈哈！我、我不跑了——不跑了——你、你别追——！"
		},
		{
			"speaker": "",
			"text": "（车轮终于慢了下来。攻城车打了个响亮的饱嗝，把她「噗」地吐回了战场入口——然后又心满意足地睡着了）"
		},
		{
			"speaker": "公主",
			"text": "……呜……鞋、鞋子里全是刷毛……再、再来一次……这次一定……",
			"emotion": "helpless_1"
		},
		{
			"actions": [
				{
					"time": 0.6,
					"do": "fade_out"
				},
				{
					"state": "",
