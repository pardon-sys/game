		"rack": {
			"lines": [
				{
					"text": "（药草架。薄荷叶、冰晶草、薰衣草、痒痒菇粉、羽毛花、蜂蜜根、暖姜根、酸果皮……一束束挂着晾干）",
					"speaker": ""
				}
			]
		},
		"book": {
			"lines": [
				{
					"text": "（一排旧配方本。最上面那本被水泡过，书页皱成一团）",
					"speaker": ""
				}
			]
		},
		"cauldron": {
			"lines": [
				{
					"text": "（药锅咕嘟咕嘟地冒着泡。闻起来凉凉的，又有点甜）",
					"speaker": ""
				}
			]
		},
		"desk": {
			"lines": [
				{
					"text": "（桌上摊着一张写满小字的纸：「试药员须知：一、配错了不许哭……」）",
					"speaker": ""
				},
				{
					"text": "……第一条就不太对劲啊。",
					"speaker": "公主",
					"emotion": "sad"
				}
			]
		}
	}
}
