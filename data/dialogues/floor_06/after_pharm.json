				}
			]
		},
		"kq_samples_busy2": {
			"lines": [
				{
					"text": "地窖里那一团，奶奶昨晚下去拿药，被它挠得差点没爬上来。"
				},
				{
					"text": "活板门开着。……小心楼梯，有一级是松的。"
				}
			],
			"prompt": "（手印样本）",
			"choices": [
				{
					"text": "知道了"
				},
				{
					"text": "（先放一放）",
					"set": {
						"vars": {
							"kq_req": "samples"
						},
						"call": "kq_abandon"
					}
				}
			]
		},
		"kq_samples_report3": {
			"lines": [
				{
					"text": "……三块。好孩子。"
				},
				{
					"text": "（奶奶把瓶子凑到灯下，眯着眼看了好久）",
					"speaker": ""
				},
				{
					"text": "……这东西，是笑声做的。"
				},
				{
					"text": "笑声？",
					"speaker": "公主",
					"emotion": "surprise"
				},
				{
					"text": "被偷走的笑声。挤在一起，就变成了手。……它们一直想往一个方向爬。"
				},
				{
					"text": "……盔甲那边。",
					"speaker": "公主",
					"emotion": "sad"
				},
				{
					"text": "笑声被偷走的人，夜里会做噩梦。……那个骑士，一晚上说了好多梦话。"
				},
				{
					"text": "……说了什么？",
					"speaker": "公主",
					"emotion": "surprise"
				},
				{
					"text": "听不清。……一直在叫一个人。"
				},
				{
					"text": "要压住它们，得配安神香。……可是还缺三味药。"
				},
				{
					"text": "笑铃草、软须苔、哈欠花。……地窖最里面那道小门，通到矿道深处的草药洞。"
				},
				{
					"text": "奶奶腿脚不行了。……光着脚去，别怕痒。"
				},
				{
					"text": "……为什么要光着脚？",
					"speaker": "公主",
					"emotion": "surprise"
				},
				{
					"text": "那几味药，认人的脚。穿鞋的，它们不让摘。"
				}
			],
			"set": {
				"vars": {
					"kq_req": "samples"
				},
				"call": "kq_report"
			}
		},
