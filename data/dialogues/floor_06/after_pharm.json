{
	"name": "药剂师奶奶",
	"entries": [
		{
			"if": {
				"flag": "kq_samples_active",
				"eq": {
					"kq_samples_stage": 3
				}
			},
			"node": "kq_samples_report"
		},
		{
			"if": {
				"flag": "kq_samples_active"
			},
			"node": "kq_samples_busy"
		},
		{
			"if": {
				"flag": "kq_samples_open"
			},
			"node": "kq_samples_offer"
		},
		{
			"if": {
				"flag": "errand_sifting_open"
			},
			"node": "errand_sifting"
		},
		{
			"if": {
				"flag": "errand_sifting_active"
			},
			"node": "errand_sifting_active"
		},
		{
			"if": {
				"flag": "errand_sifting_done",
				"not": "dlg_floor_06/after_pharm_errand_sifting_done"
			},
			"node": "errand_sifting_done"
		},
		{
			"if": {
				"var": {
					"after_day": [
						"==",
						3
					]
				}
			},
			"node": "d3"
		},
		{
			"node": "default"
		}
	],
	"nodes": {
		"d3": {
			"lines": [
				{
					"text": "试药员来啦？药锅已经热好了。"
				}
			]
		},
		"default": {
			"lines": [
				{
					"text": "止痒药、薄荷糖、清心花露……需要的话，奶奶这里都有。"
				},
				{
					"text": "……不过，都要拿工时来换哦。呵呵。"
				}
			]
		},
		"errand_sifting": {
			"lines": [
				{
					"text": "工房补货，晒好的叶片要筛松再风选。到门外的晒架帮帮忙？算三工时。",
					"speaker": "药剂师奶奶"
				}
			],
			"prompt": "接下这个委托？",
			"choices": [
				{
					"text": "我来！",
					"next": "errand_sifting_accept"
				},
				{
					"text": "等一下再说",
					"next": ""
				}
			]
		},
		"errand_sifting_accept": {
			"lines": [
				{
					"text": "门外晒架的风扇已经备好。听拍子筛松，再看叶片图标调风向，最后分三袋。",
					"speaker": "药剂师奶奶"
				}
			],
			"set": {
				"vars": {
					"errand_req": "sifting"
				},
				"call": "errand_start"
			}
		},
		"errand_sifting_active": {
			"lines": [
				{
					"text": "工房门外晒架，不在药锅旁边。",
					"speaker": "药剂师奶奶"
				}
			]
		},
		"errand_sifting_done": {
			"lines": [
				{
					"text": "三袋都齐了，标签也没串。明天补货，少不了你这一份。",
					"speaker": "药剂师奶奶"
				}
			]
		},
		"kq_samples_report": {
			"lines": [
				{
					"text": "……三块。好孩子。"
				},
				{
					"text": "（奶奶把瓶子凑到灯下，眯着眼看了好久）",
					"speaker": ""
				},
				{
					"text": "……这东西，是笑声做的。"
				},
				{
					"text": "笑声？",
					"speaker": "公主",
					"emotion": "surprise"
				},
				{
					"text": "被偷走的笑声。挤在一起，就变成了手。……它们一直想往一个方向爬。"
				},
				{
					"text": "……盔甲那边。",
					"speaker": "公主",
					"emotion": "sad"
				}
			],
			"set": {
				"vars": {
					"kq_req": "samples"
				},
				"call": "kq_report"
			}
		},
		"kq_samples_busy": {
			"lines": [
				{
					"text": "担架走过的石板路、地牢入口的铁门……还有，奶奶的地窖里，昨晚好像也钻进去了一团。"
				},
				{
					"text": "（藏着手印的石头、木桶，靠近了会晃。按住 E 笑一笑，它就会爬出来）",
					"speaker": ""
				}
			],
			"prompt": "（手印样本）",
			"choices": [
				{
					"text": "知道了"
				},
				{
					"text": "（先放一放）",
					"set": {
						"vars": {
							"kq_req": "samples"
						},
						"call": "kq_abandon"
					}
				}
			]
		},
		"kq_samples_offer": {
			"lines": [
				{
					"text": "……孩子，来得正好。"
				},
				{
					"text": "那个骑士身上的手印，奶奶想配一味安神的药。"
				},
				{
					"text": "可是没有样本。……你能帮奶奶去收几块吗？"
				},
				{
					"text": "收手印？……它们会跑吧。",
					"speaker": "公主",
					"emotion": "surprise"
				},
				{
					"text": "会跑。所以要找对办法。……它们，好像喜欢笑声。"
				}
			],
			"prompt": "帮奶奶收手印样本？",
			"choices": [
				{
					"text": "交给我！",
					"set": {
						"vars": {
							"kq_req": "samples"
						},
						"call": "kq_start"
					}
				},
				{
					"text": "等一下"
				}
			]
		}
	},
	"npc": "pharmacist"
}
