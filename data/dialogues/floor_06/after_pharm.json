		"kq_samples_busy1": {
			"lines": [
				{
					"text": "地牢入口的铁门……那边阴，手印喜欢待在阴的地方。"
				},
				{
					"text": "蓝色的那孩子，别太靠近。它们好像……怕她。"
				}
			],
			"prompt": "（手印样本）",
			"choices": [
