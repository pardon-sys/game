		"d3": {
			"lines": [
				{
					"text": "试药员来啦？药锅已经热好了。"
				}
			]
		},
		"default": {
			"lines": [
				{
					"text": "止痒药、薄荷糖、清心花露……需要的话，奶奶这里都有。"
				},
				{
					"text": "……不过，都要拿工时来换哦。呵呵。"
				}
			]
		},
		"errand_sifting": {
			"lines": [
				{
					"text": "工房补货，晒好的叶片要筛松再风选。到门外的晒架帮帮忙？算三工时。",
					"speaker": "药剂师奶奶"
				}
			],
			"prompt": "接下这个委托？",
			"choices": [
				{
					"text": "我来！",
					"next": "errand_sifting_accept"
				},
				{
					"text": "等一下再说",
					"next": ""
				}
			]
		},
		"errand_sifting_accept": {
			"lines": [
				{
					"text": "门外晒架的风扇已经备好。听拍子筛松，再看叶片图标调风向，最后分三袋。",
					"speaker": "药剂师奶奶"
				}
			],
			"set": {
				"vars": {
					"errand_req": "sifting"
				},
				"call": "errand_start"
			}
		},
		"errand_sifting_active": {
			"lines": [
				{
					"text": "工房门外晒架，不在药锅旁边。",
					"speaker": "药剂师奶奶"
				}
			]
		},
		"errand_sifting_done": {
			"lines": [
				{
					"text": "三袋都齐了，标签也没串。明天补货，少不了你这一份。",
					"speaker": "药剂师奶奶"
				}
			]
		},
		"kq_samples_busy0": {
			"lines": [
				{
					"text": "担架走过的石板路。哪块石头在晃，就是哪块。"
				},
				{
					"text": "笑一笑，它就会出来。不用怕，它们不咬人。"
