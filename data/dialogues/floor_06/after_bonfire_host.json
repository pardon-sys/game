	"nodes": {
		"d1": {
			"lines": [
				{
					"text": "足枷示众？那可是小镇的传统节目！明天我带热饮去给你加油！"
				},
				{
					"text": "不、不用来！谁都不要来！",
					"speaker": "公主",
					"emotion": "angry"
				},
				{
					"text": "哈哈哈，来的人只会更多哦～"
				}
			]
		},
		"default": {
			"lines": [
				{
					"text": "篝火还烧着。累了就过来坐坐！"
				}
			]
		},
		"d1_wait": {
			"lines": [
				{
					"text": "宣判完了我请你喝热汤！……要是你还喝得下的话。"
				}
			]
		},
		"d2_wait": {
			"lines": [
				{
					"text": "示众要开始啦！我带了热饮来给你加油～还有派对用的小刷子～"
				},
				{
					"text": "小刷子是用来干什么的？！",
					"speaker": "公主",
					"emotion": "surprise"
				}
			]
		},
		"d2": {
			"lines": [
				{
					"text": "刷子祝福送到啦～感觉怎么样？是不是神清气爽？"
				},
				{
					"text": "一点都不！！",
					"speaker": "公主",
					"emotion": "angry"
				}
			]
		},
		"d2_faint": {
			"lines": [
				{
					"text": "哎呀呀，祝福过头了……下次刷子我换软一点的！"
				},
				{
					"text": "没有下次了！！",
					"speaker": "公主",
					"emotion": "angry"
				}
			]
		},
		"errand_dance": {
			"lines": [
				{
					"text": "哎呀～正好！庆功宴的篝火舞，正缺一个领舞的人！"
				},
				{
					"text": "来跟我们排练一下吧？跳得好的话，给你记三个工时～"
				}
			],
			"prompt": "去篝火边排练舞蹈？",
			"choices": [
				{
					"text": "跳就跳！",
					"next": "errand_dance_accept"
				},
				{
					"text": "等一下再说",
					"next": ""
				}
			]
		},
		"errand_dance_accept": {
			"lines": [
				{
					"text": "好耶～篝火边见！"
				}
			],
			"set": {
				"vars": {
					"errand_req": "dance"
				},
				"call": "errand_start"
			}
		},
		"errand_dance_active": {
			"lines": [
				{
					"text": "快来篝火边～大家都等着你呢！"
				}
			]
		},
		"errand_dance_done": {
			"lines": [
				{
					"text": "领舞大人～庆功宴那天要穿漂亮点哦！"
				},
				{
					"text": "……光脚的话会被踩影子吗？",
					"speaker": "公主",
					"emotion": "sad"
				},
				{
					"text": "会～",
					"speaker": "篝火派对的主人"
				}
			]
		},
		"errand_massage": {
			"lines": [
				{
					"text": "哎呀～脸色好疲惫哦。脚底是不是很酸？"
				},
				{
					"text": "我新学了一套「足疗」，正缺个试手的人。按完给你记三个工时，怎么样？"
				}
			],
			"prompt": "让主人试新手法？",
			"choices": [
				{
					"text": "……好吧，就一次",
					"next": "errand_massage_accept"
				},
				{
					"text": "等一下再说",
					"next": ""
				}
			]
		},
		"errand_massage_accept": {
			"lines": [
				{
					"text": "好耶～篝火边的长椅上等你！"
				}
			],
			"set": {
				"vars": {
					"errand_req": "massage"
				},
				"call": "errand_start"
			}
		},
		"errand_massage_active": {
			"lines": [
				{
					"text": "快来长椅上坐好～鞋子记得脱哦！"
				}
			]
		},
		"errand_massage_done": {
			"lines": [
				{
					"text": "脚底还轻松吗？「篝火足疗铺」随时欢迎～"
				},
				{
					"text": "……不来。",
					"speaker": "公主",
					"emotion": "shy"
				}
			]
		},
		"penalty_offer": {
			"lines": [
				{
					"text": "哎呀～赎罪簿上还有受罚没抵？"
				},
				{
					"text": "来篝火边跳支舞，就当抵罚啦～"
				}
			],
			"prompt": "在篝火边罚跳舞抵受罚？",
			"choices": [
				{
					"text": "跳就跳！",
					"next": "penalty_go"
				},
				{
					"text": "等一下再说",
					"next": ""
				}
			]
		},
		"penalty_go": {
			"lines": [
				{
					"text": "好。"
				}
			],
			"set": {
				"vars": {
					"penalty_req": "dance"
				},
				"call": "after_penalty"
			}
		}
	},
	"npc": "bonfire_host"
