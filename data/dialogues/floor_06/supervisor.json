{
	"name": "市场监督",
	"npc": "supervisor",
	"entries": [
		{
			"if": {
				"eq": {
					"f6_attitude": "honest"
				}
			},
			"node": "hello_honest"
		},
		{
			"if": {
				"eq": {
					"f6_attitude": "defiant"
				}
			},
			"node": "hello_defiant"
		},
		{
			"if": {
				"eq": {
					"f6_attitude": "beg"
				}
			},
			"node": "hello_beg"
		},
		{
			"node": "hello_honest"
		}
	],
	"nodes": {
		"hello_honest": {
			"lines": [
				{
					"text": "欢迎来到集贸市场。……你就是那个从地牢出来的姑娘？"
				},
				{
					"text": "听说你挺老实的。在这儿守规矩就好。"
				}
			],
			"next": "hub"
		},
		"hello_defiant": {
			"lines": [
				{
					"text": "哦——就是你啊，那个跟队长顶嘴的。"
				},
				{
					"text": "在我的市场里可别闹事。"
				}
			],
			"next": "hub"
		},
		"hello_beg": {
			"lines": [
				{
					"text": "啊，「爱笑的公主」。整个集市都在说你呢。"
				},
				{
					"text": "别害羞，大家都没有恶意。"
				}
			],
			"next": "hub"
		},
		"hub": {
			"prompt": "要做什么？",
			"choices": [
				{
					"text": "看看商品",
					"next": "shop",
					"return": true
				},
				{
					"text": "市场有什么规矩？",
					"next": "rules",
					"return": true
				},
				{
					"text": "我的事……传开了吗？",
					"next": "rumor",
					"return": true
				},
				{
					"text": "「爱笑的公主」……是在说我吗？",
					"next": "laughing",
					"return": true,
					"if": {
						"eq": {
							"f6_attitude": "beg"
						}
					},
					"once": true
				},
				{
					"text": "队长说我坏话了吗？",
					"next": "badword",
					"return": true,
					"if": {
						"eq": {
							"f6_attitude": "defiant"
						}
					},
					"once": true
				},
				{
					"text": "再见",
					"next": "bye"
				}
			]
		},
		"shop": {
			"set": {
				"call": "open_shop"
			}
		},
		"rules": {
			"lines": [
				{
					"text": "一手交钱，一手交货。金币就行。"
				},
				{
					"text": "矿道里挖出来的、地面上偷偷运下来的，我都管。"
				}
			]
		},
		"rumor": {
			"goto": [
				{
					"if": {
						"eq": {
							"f6_attitude": "honest"
						}
					},
					"node": "rumor_honest"
				},
				{
					"if": {
						"eq": {
							"f6_attitude": "defiant"
						}
					},
					"node": "rumor_defiant"
				},
				{
					"if": {
						"eq": {
							"f6_attitude": "beg"
						}
					},
					"node": "rumor_beg"
				},
				{
					"node": "rumor_honest"
				}
			]
		},
		"rumor_honest": {
			"lines": [
				{
					"text": "传开了一点。说你什么都不记得，又说你提到了「黑影」。"
				},
				{
					"text": "矿工们听到黑影，脸色都变了。"
				}
			]
		},
		"rumor_defiant": {
			"lines": [
				{
					"text": "传得可厉害了。说你被锁着还冲队长喊「我可是公主」。"
				},
				{
					"text": "队员们学你学得可像了。"
				}
			]
		},
		"rumor_beg": {
			"lines": [
				{
					"text": "说你被挠得笑个不停，还一边笑一边求饶。"
				},
				{
					"text": "小孩子们都在学你笑呢。"
				}
			]
		},
		"laughing": {
			"lines": [
				{
					"text": "哈哈，是啊。不过这在小镇里是夸人的话——笑得出来的人，运气都不会太差。"
				}
			]
		},
		"badword": {
			"lines": [
				{
					"text": "坏话？他说你「嘴硬，但骨头也硬」。"
				},
				{
					"text": "从他嘴里说出来，这算是夸奖了。"
				}
			]
		},
		"bye": {
			"lines": [
				{
					"text": "缺什么就回来买。"
				}
			]
		}
	}
}
