{
	"name": "起雾的镜子",
	"entries": [
		{
			"node": "default"
		}
	],
	"nodes": {
		"default": {
			"lines": [
				{
					"text": "（一面落满水汽的大镜子。她用袖子擦了擦——镜面上有一行用手指写的字，被水汽留了下来）",
					"speaker": ""
				},
				{
					"text": "（「姐姐，泡好了吗？——小不点」）",
					"speaker": ""
				},
				{
					"text": "（字的下面，还用手指画了一个大大的数字：「2」。……大概是在数第几号浴池）",
					"speaker": ""
				},
				{
					"text": "……小不点。又是这个名字。",
					"speaker": "公主",
					"emotion": "surprise"
				},
				{
					"text": "……短裤里面，也绣着这三个字。",
					"speaker": "蓝色的公主"
				},
				{
					"text": "……这个王宫里，以前住着一个「小不点」，还有她的姐姐。",
					"speaker": "公主",
					"emotion": "sad"
				}
			]
		}
	}
}
