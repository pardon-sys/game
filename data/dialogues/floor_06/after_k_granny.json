		"t0": {
			"lines": [
				{
					"text": "昨晚……奶奶的笑声，是你们帮忙找回来的吧。"
				},
				{
					"text": "拿着，刚烤好的。……路上小心。"
				}
			]
		},
		"t1": {
			"lines": [
				{
					"text": "那个孩子……被抬过去的时候，奶奶看了一眼。"
				},
				{
					"text": "盔甲上的花纹，奶奶年轻的时候好像在哪里见过。"
				},
				{
					"text": "……是在哪里呢。老了，记不清了。"
				}
			]
		},
		"t2": {
			"lines": [
				{
					"text": "昨晚的饼干还剩一些，要不要带着？"
				},
				{
					"text": "东北角那边……吵吵嚷嚷的，出什么事了？"
				}
			]
		}
	}
