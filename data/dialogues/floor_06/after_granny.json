{
	"name": "面包店的奶奶",
	"entries": [
		{
			"if": {
				"flag": "after_festival_on",
				"not": "stall_guess_done"
			},
			"node": "stall_offer"
		},
		{
			"if": {
				"flag": [
					"after_festival_on",
					"stall_guess_done"
				]
			},
			"node": "stall_done"
		},
		{
			"if": {
				"flag": "errand_cookies_open"
			},
			"node": "errand_cookies"
		},
		{
			"if": {
				"flag": "errand_cookies_active"
			},
			"node": "errand_cookies_active"
		},
		{
			"if": {
				"flag": "errand_cookies_done",
				"not": "dlg_floor_06/after_granny_errand_cookies_done"
			},
			"node": "errand_cookies_done"
		},
		{
			"if": {
				"var": {
					"after_day": [
						"==",
						2
					]
				},
				"not": "after_done_d2_morning"
			},
			"node": "d2_wait"
		},
		{
			"if": {
				"var": {
					"after_day": [
						"==",
						2
					]
				},
				"flag": [
					"after_done_d2_morning",
					"after_d2_fainted"
				]
			},
			"node": "d2_faint"
		},
		{
			"if": {
				"var": {
					"after_day": [
						"==",
						2
					]
				},
				"flag": "after_done_d2_morning"
			},
			"node": "d2"
		},
		{
			"if": {
				"var": {
					"after_day": [
						"==",
						1
					]
				},
				"not": "after_done_d1_afternoon"
			},
			"node": "d1_wait"
		},
		{
			"if": {
				"var": {
					"after_day": [
						"==",
						1
					]
				}
			},
			"node": "d1"
		},
		{
			"node": "default"
		}
	],
	"nodes": {
		"d1": {
			"lines": [
				{
					"text": "别怕，孩子。奶奶年轻的时候，也在那副足枷上坐过呢。"
				},
				{
					"text": "最难熬的不是坐着……是那些小鬼头，专门挑脚心挠。呵呵呵。"
				},
				{
					"text": "……奶、奶奶！这不是安慰吧？！",
					"speaker": "公主",
					"emotion": "surprise"
				}
			]
		},
		"default": {
			"lines": [
				{
					"text": "店还没盖好，饼干先欠着。"
				}
			]
		},
		"d1_wait": {
			"lines": [
				{
					"text": "孩子，别怕。大家都看见你在城门外守了一整晚。"
				}
			]
		},
		"d2_wait": {
			"lines": [
				{
					"text": "孩子，脚底板放松。越绷得紧，越痒。"
				},
				{
					"text": "……奶奶，这个建议好像没什么用……",
					"speaker": "公主",
					"emotion": "sad"
				}
			]
		},
		"d2": {
			"lines": [
				{
					"text": "来，泡泡脚。奶奶熬了薄荷水，脚底就不麻了。"
				}
			]
		},
		"d2_faint": {
			"lines": [
				{
					"text": "可怜的孩子，笑得都晕过去了……那几个小鬼头，奶奶替你骂过了。"
				}
			]
		},
		"errand_cookies": {
			"lines": [
				{
					"text": "孩子，来得正好。刚烤好一篮饼干，想送给守城门的队员们——他们守了一整夜呢。"
				},
				{
					"text": "奶奶腿脚不方便，你帮我跑一趟？"
				},
				{
					"text": "就是……路上那几个小馋猫，鼻子灵得很。闻到香味，准会缠上来。"
				}
			],
			"prompt": "帮奶奶送饼干？",
			"choices": [
				{
					"text": "交给我吧！",
					"next": "errand_cookies_accept"
				},
				{
					"text": "等一下再说",
					"next": ""
				}
			]
		},
		"errand_cookies_accept": {
			"lines": [
				{
					"text": "好孩子。篮子拿稳了——被小鬼们缠上了，分他们一块就肯走；不想给，就跑快点。"
				},
				{
					"text": "（拿到了一篮饼干，一共六块）",
					"speaker": ""
				}
			],
			"set": {
				"vars": {
					"errand_req": "cookies"
				},
				"call": "errand_start"
			}
		},
		"errand_cookies_active": {
			"lines": [
				{
					"text": "快去吧，饼干要凉了。守城门的队员在南边城门那里。"
				}
			]
		},
		"errand_cookies_done": {
			"lines": [
				{
					"text": "队员们说饼干很好吃。辛苦你啦。"
				},
				{
					"text": "……腰没被那几个小鬼挠坏吧？呵呵。"
				}
			]
		},
		"stall_offer": {
			"lines": [
				{
					"text": "来玩奶奶的「脚底猜猜乐」吗？猜对三次送饼干～"
				}
			],
			"prompt": "玩脚底猜猜乐？",
			"choices": [
				{
					"text": "玩！",
					"next": "stall_go"
				},
				{
					"text": "等一下再说",
					"next": ""
				}
			]
		},
		"stall_go": {
			"lines": [
				{
					"text": "把脚伸进箱子里～"
				}
			],
			"set": {
				"vars": {
					"stall_req": "guess"
				},
				"call": "festival_stall"
			}
		},
		"stall_done": {
			"lines": [
				{
					"text": "饼干好吃吗？明年还来呀～"
				},
				{
					"text": "……明年的箱子里不许放羊。",
					"speaker": "公主",
					"emotion": "sad"
				}
			]
		}
	},
	"npc": "granny"
}
