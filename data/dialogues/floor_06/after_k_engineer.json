	"nodes": {
		"t0": {
			"lines": [
				{
					"text": "营地底下……一整夜都有铁链在响。"
				},
				{
					"text": "我躺在床上听了半宿。……那不是锁着的人能弄出来的声音。"
				}
			]
		},
		"t1": {
			"lines": [
				{
					"text": "那套盔甲，做工是真的好。"
				},
				{
					"text": "……可是我看了半天，看不出是哪里打的。不是这附近的手艺。"
				}
			]
		},
		"t2": {
			"lines": [
				{
					"text": "地牢入口那边的门，昨天晚上还是钉死的。……今天早上，钉子掉了一地。"
				}
			]
		},
		"kq_host_t1": {
			"lines": [
				{
					"text": "八音盒？……我看看。"
				},
				{
					"text": "（工匠转了转发条，里面「咔啦」一声）"
				},
				{
					"text": "里面掉了三个零件。……训练室后面那间旧仓库里，以前堆着好多旧玩具，拆下来就能用。"
				},
				{
					"text": "……那仓库里的东西，有点怪。音乐一停，它们就会动。小心点。"
				}
			],
			"set": {
				"vars": {
					"kq_req": "host"
				},
				"call": "kq_next"
			}
		}
	}
