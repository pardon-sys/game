	"nodes": {
		"fabric": {
			"lines": [
				{
					"speaker": "",
					"text": "（一卷卷彩色的布料，粉的、蓝的、黄的……最下面压着一卷厚厚的白棉布）"
				}
			]
		},
		"form": {
			"lines": [
				{
					"speaker": "",
					"text": "（人台上套着一件还没缝完的棉衣，插着好几根针）"
				},
				{
					"speaker": "公主",
					"text": "……这个人台的腰，跟我差不多细。",
					"emotion": "surprise"
				}
			]
		},
		"mirror": {
			"lines": [
				{
					"speaker": "",
					"text": "（落地镜。镜子里的自己头发有点乱）"
				}
			]
		},
		"desk": {
			"lines": [
				{
					"speaker": "",
					"text": "（工作台上摊着一本尺码簿。最旧的一页上写着：「二十二码半，小棉袜一双，记账——」后面的字被墨水晕开了）"
				}
			]
		}
	}
}
