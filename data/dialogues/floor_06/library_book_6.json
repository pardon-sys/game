		"frag3": {
			"lines": [
				{
					"text": "（一本厚厚的记录簿。最后一页写着书房的开门方法，可是被人用墨水涂掉了大半）",
					"speaker": ""
				},
				{
					"text": "「书房的门：四位数字。」",
					"speaker": ""
				},
				{
					"text": "「第一位：浴场的镜子上，水汽写下的数字。」",
					"speaker": ""
				},
				{
					"text": "「第二位：两位小殿下洗脚水的日子（排班表）。」",
					"speaker": ""
				},
				{
					"text": "「第三位：衣帽间里，小殿下礼服的尺码。」",
					"speaker": ""
				},
				{
					"text": "「第四位：训练场墙上，骑士刻下的划痕。」",
					"speaker": ""
				},
				{
					"text": "……全拼起来了。四个数字，就藏在我们走过的四个房间里。",
					"speaker": "公主",
					"emotion": "surprise"
				}
			]
		},
