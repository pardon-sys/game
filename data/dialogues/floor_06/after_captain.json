	"nodes": {
		"d1": {
			"lines": [
				{
					"text": "工时的事，别想着讨价还价。……明天一早，广场。别迟到。"
				}
			],
			"next": "d1_menu"
		},
		"default": {
			"lines": [
				{
					"text": "……有事？没事就去干活。"
				}
			]
		},
		"d1_menu": {
			"prompt": "还有什么事？",
			"choices": [
				{
					"text": "她说的「钥匙」……是什么意思？",
					"next": "d1_key",
					"return": true
				},
				{
					"text": "早上那条裤子……",
					"next": "d1_pants",
					"return": true
				},
				{
					"text": "没有了",
					"next": ""
				}
			]
		},
		"d1_key": {
			"lines": [
				{
					"text": "……殿下累糊涂了。打了一整晚的仗，谁都会说胡话。"
				},
				{
					"text": "别多想。你只要把工时还清就行。"
				},
				{
					"text": "（队长说完就转过身去了。……好像不太想让人看见他的脸）",
					"speaker": ""
				}
			]
		},
		"d1_pants": {
			"lines": [
				{
					"text": "嘘——！"
				},
				{
					"text": "……那件事，出了这个广场谁都不许提。你也一样。"
				},
				{
					"text": "……真是的。小时候是涂鸦，现在是裤子……"
				},
				{
					"text": "……没什么。去干活。"
				}
			]
		},
		"d1_wait": {
			"lines": [
				{
					"text": "……还没到时候。去台子前面站好，镇长马上就来。"
				}
			]
		},
		"d2_wait": {
			"lines": [
				{
					"text": "足枷就在广场正中间。自己过去，别让我派人押你。"
				},
				{
					"text": "……按规矩来，不会太为难你。"
				}
			]
		},
		"d2": {
			"lines": [
				{
					"text": "……示众结束了。规矩就是规矩，你也守了。"
				},
				{
					"text": "……下午的活，别耽误。"
				}
			]
		},
		"d2_faint": {
			"lines": [
				{
					"text": "……晕过去的事，不会写进记录。"
				},
				{
					"text": "……我也没看见。什么都没看见。"
				}
			]
		}
	},
	"npc": "captain"
