{
	"name": "工匠",
	"entries": [
		{
			"if": {
				"flag": "after_festival_on",
				"not": "stall_ice_done"
			},
			"node": "stall_offer"
		},
		{
			"if": {
				"flag": [
					"after_festival_on",
					"stall_ice_done"
				]
			},
			"node": "stall_done"
		},
		{
			"if": {
				"flag": "errand_gate_chain_open"
			},
			"node": "errand_gate_chain"
		},
		{
			"if": {
				"flag": "errand_gate_chain_active"
			},
			"node": "errand_gate_chain_active"
		},
		{
			"if": {
				"flag": "errand_ladder_open"
			},
			"node": "errand_ladder"
		},
		{
			"if": {
				"flag": "errand_ladder_active"
			},
			"node": "errand_ladder_active"
		},
		{
			"if": {
				"flag": "errand_gate_chain_done",
				"not": "dlg_floor_06/after_engineer_errand_gate_chain_done"
			},
			"node": "errand_gate_chain_done"
		},
		{
			"if": {
				"flag": "errand_ladder_done",
				"not": "dlg_floor_06/after_engineer_errand_ladder_done"
			},
			"node": "errand_ladder_done"
		},
		{
			"if": {
				"var": {
					"after_day": [
						"==",
						2
					]
				},
				"not": "after_done_d2_morning"
			},
			"node": "d2_wait"
		},
		{
			"if": {
				"var": {
					"after_day": [
						"==",
						2
					]
				},
				"flag": [
					"after_done_d2_morning",
					"after_d2_fainted"
				]
			},
			"node": "d2_faint"
		},
		{
			"if": {
				"var": {
					"after_day": [
						"==",
						2
					]
				},
				"flag": "after_done_d2_morning"
			},
			"node": "d2"
		},
		{
			"if": {
				"var": {
					"after_day": [
						"==",
						1
					]
				},
				"not": "after_done_d1_afternoon"
			},
			"node": "d1_wait"
		},
		{
			"if": {
				"var": {
					"after_day": [
						"==",
						1
					]
				}
			},
			"node": "d1"
		},
		{
			"node": "default"
		}
	],
	"nodes": {
		"d1": {
			"lines": [
				{
					"text": "上午的砖搬得不错嘛！虽然一半掉在了自己脚上。"
				},
				{
					"text": "城墙还差两段。往后几天，有的是活给你干。"
				}
			]
		},
		"default": {
			"lines": [
				{
					"text": "锤子、钉子、木料……今天也是修城墙的一天。"
				}
			]
		},
		"d1_wait": {
			"lines": [
				{
					"text": "宣判台是我早上钉的！结实着呢，你随便站。"
				}
			]
		},
		"d2_wait": {
			"lines": [
				{
					"text": "足枷是我昨晚连夜修的。结实着呢……啊，这么说好像不太好。"
				}
			]
		},
		"d2": {
			"lines": [
				{
					"text": "示众完了？那下午来帮我搬木料！城墙还差一段。"
				}
			]
		},
		"d2_faint": {
			"lines": [
				{
					"text": "听说你笑晕了……木料今天就算了，明天再搬。"
				}
			]
		},
		"errand_ladder": {
			"lines": [
				{
					"text": "哎，姑娘！会爬梯子吗？屋檐上破了个洞，我这把老腰爬不上去了。"
				},
				{
					"text": "帮个忙，我给你在赎罪簿上记三个工时。"
				}
			],
			"prompt": "帮工匠补屋檐？",
			"choices": [
				{
					"text": "交给我！",
					"next": "errand_ladder_accept"
				},
				{
					"text": "等一下再说",
					"next": ""
				}
			]
		},
		"errand_ladder_accept": {
			"lines": [
				{
					"text": "好嘞！梯子我已经架好了——就在那边的脚手架房子底下。"
				}
			],
			"set": {
				"vars": {
					"errand_req": "ladder"
				},
				"call": "errand_start"
			}
		},
		"errand_ladder_active": {
			"lines": [
				{
					"text": "梯子在脚手架房子那边。上去吧，我扶着。"
				}
			]
		},
		"errand_ladder_done": {
			"lines": [
				{
					"text": "屋檐补得真结实。……脚丫子还红着吗？"
				},
				{
					"text": "……不准提脚！",
					"speaker": "公主",
					"emotion": "angry"
				}
			]
		},
		"errand_gate_chain": {
			"lines": [
				{
					"text": "城门能通行了，辅助链条却还挂在轮子外。想再抵三工时吗？",
					"speaker": "工匠"
				},
				{
					"text": "得有人仰面钻进检修槽里穿链，我在外面报位置。门已经用支架固定好了。",
					"speaker": "工匠"
				}
			],
			"prompt": "帮工匠重新穿好辅助链条？",
			"choices": [
				{
					"text": "好，我来穿！",
					"next": "errand_gate_chain_accept"
				},
				{
					"text": "等一下再说",
					"next": ""
				}
			]
		},
		"errand_gate_chain_accept": {
			"lines": [
				{
					"text": "去城门内侧的检修槽。对了——鞋得脱，槽口卡鞋。做过的部分会锁住，中途回来也能接着做。",
					"speaker": "工匠"
				}
			],
			"set": {
				"vars": {
					"errand_req": "gate_chain"
				},
				"call": "errand_start"
			}
		},
		"errand_gate_chain_active": {
			"lines": [
				{
					"text": "城门内侧，检修板旁边。我的工具都摆好了。",
					"speaker": "工匠"
				}
			]
		},
		"errand_gate_chain_done": {
			"lines": [
				{
					"text": "辅助链条转得顺。你那双脚，报位置比我还准。",
					"speaker": "工匠"
				},
				{
					"text": "不许再提我的脚！",
					"speaker": "公主",
					"emotion": "angry"
				}
			]
		},
		"stall_offer": {
			"lines": [
				{
					"text": "冰雕摊！要请蓝色的那位来刻——你去问问？"
				},
				{
					"text": "你在旁边帮忙也行～"
				}
			],
			"prompt": "让蓝色公主来刻冰雕？",
			"choices": [
				{
					"text": "交给我们！",
					"next": "stall_go"
				},
				{
					"text": "等一下再说",
					"next": ""
				}
			]
		},
		"stall_go": {
			"lines": [
				{
					"text": "好嘞，冰块桌子都准备好了！"
				}
			],
			"set": {
				"vars": {
					"stall_req": "ice"
				},
				"call": "festival_stall"
			}
		},
		"stall_done": {
			"lines": [
				{
					"text": "那三座冰雕，大家都抢着看呢。……尤其是最后那一座。"
				}
			]
		}
	},
	"npc": "miner"
}
