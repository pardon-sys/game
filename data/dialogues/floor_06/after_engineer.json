	"nodes": {
		"d1": {
			"lines": [
				{
					"text": "上午的砖搬得不错嘛！虽然一半掉在了自己脚上。"
				},
				{
					"text": "城墙还差两段。往后几天，有的是活给你干。"
				}
			]
		},
		"default": {
			"lines": [
				{
					"text": "锤子、钉子、木料……今天也是修城墙的一天。"
				}
			]
		},
		"d1_wait": {
			"lines": [
				{
					"text": "宣判台是我早上钉的！结实着呢，你随便站。"
				}
			]
		},
		"d2_wait": {
			"lines": [
				{
					"text": "足枷是我昨晚连夜修的。结实着呢……啊，这么说好像不太好。"
				}
			]
		},
		"d2": {
			"lines": [
				{
					"text": "示众完了？那下午来帮我搬木料！城墙还差一段。"
