		"t0": {
			"lines": [
				{
					"text": "……陛下每天晚上，都要自己去婴儿房，给小殿下们掖被角。",
					"speaker": "年轻的女仆长（小画像）"
				},
				{
					"text": "……明明有我们在。……她还是要自己去。",
					"speaker": "年轻的女仆长（小画像）"
				}
			]
		},
		"t1": {
			"lines": [
				{
					"text": "……陛下怕痒，全王宫都知道。",
					"speaker": "年轻的女仆长（小画像）"
				},
				{
					"text": "……可是她说：「被孩子们挠，是当妈妈最好的奖励。」",
					"speaker": "年轻的女仆长（小画像）"
				},
				{
					"text": "……说完，又被挠倒了。",
					"speaker": "年轻的女仆长（小画像）"
				}
			]
		},
		"t2": {
			"lines": [
				{
					"text": "……我第一次打碎茶杯，吓得哭了。",
					"speaker": "年轻的女仆长（小画像）"
				},
				{
					"text": "……陛下蹲下来，和我一起捡碎片。",
					"speaker": "年轻的女仆长（小画像）"
				},
				{
					"text": "……「杯子碎了，可以再买。你的手指，可不能划破。」",
					"speaker": "年轻的女仆长（小画像）"
				}
			]
		},
		"t3": {
			"lines": [
				{
					"text": "……小殿下们发烧的那一夜，陛下守了一整晚。",
					"speaker": "年轻的女仆长（小画像）"
				},
				{
					"text": "……天亮的时候，她靠着摇篮睡着了。……手里，还攥着湿毛巾。",
					"speaker": "年轻的女仆长（小画像）"
				}
			]
		},
		"t4": {
			"lines": [
				{
					"text": "……陛下说，等小殿下们长大了，要教她们自己梳头、自己系发带。",
					"speaker": "年轻的女仆长（小画像）"
				},
				{
					"text": "……她说这话的时候，正在一下一下地，给她们系发带。",
					"speaker": "年轻的女仆长（小画像）"
				}
			]
		}
	}
}
