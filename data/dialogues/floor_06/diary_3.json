			"lines": [
				{
					"text": "（一页从日记本上撕下来的纸，字迹很温柔。署名是「乳母」）",
					"speaker": ""
				},
				{
					"text": "「……只有爱笑的那个唱那首歌，爱哭的那个才睡得着。我唱不行，陛下唱也不行。……真奇怪」",
					"speaker": ""
				}
			],
			"set": {
				"flags": [
					"palace_diary_3"
				],
				"call": "palace_diary_page"
			},
			"next": "check"
		},
