{
	"name": "篝火派对的主人",
	"npc": "bonfire_host",
	"entries": [
		{
			"if": {
				"not": "equip_unlocked"
			},
			"node": "unlock"
		},
		{
			"node": "hub"
		}
	],
	"nodes": {
		"unlock": {
			"lines": [
				{
					"text": "哎呀，你们回来啦！派对是开不成了，篝火倒是还烧着。"
				},
				{
					"text": "对了对了——我本来在准备下次派对的「挠痒大赛」，做了好多比赛用的护具和小装饰。"
				},
				{
					"text": "护腋的垫子、厚袜子、舞鞋……有的能挡挠痒，有的让人跑得快，代价嘛……穿上就知道啦。"
				},
				{
					"text": "都挂到补给站卖了。这个送你们——派对的彩带蝴蝶结，系在腰上，戴着心情就好！"
				},
				{
					"text": "……就是上面的小铃铛有点吵。嘿嘿。"
				},
				{
					"text": "（之后可以在背包的「装备」页给两个人换装备）",
					"speaker": ""
				}
			],
			"set": {
				"flags": [
					"equip_unlocked"
				],
				"give_item": {
					"equip_party_bow": 1
				}
			},
			"next": "hub_after_unlock"
		},
		"hub_after_unlock": {
			"lines": [
				{
					"text": "每个怕痒的地方都能穿一件。两个人各穿各的哦！"
				}
			],
			"next": "hub"
		},
		"hub": {
			"prompt": "要做什么？",
			"choices": [
				{
					"text": "在篝火旁休息一下（护具的次数也会恢复）",
					"next": "rest",
					"return": true
				},
				{
					"text": "装备是怎么回事？",
					"next": "about",
					"return": true
				},
				{
					"text": "再见",
					"next": "bye"
				}
			]
		},
		"rest": {
			"lines": [
				{
					"text": "坐吧，坐吧。护垫我帮你拍蓬一点。"
				}
			],
			"set": {
				"call": "rest"
			}
		},
		"about": {
			"lines": [
				{
					"text": "脚心、腋下、腰、脖子、肚子、胸、大腿、屁股——每个地方都能穿一件。"
				},
				{
					"text": "有的能挡几下挠痒，用完了在篝火这儿休息一下就恢复。"
				},
				{
					"text": "有的让人更敏感，但是跑得快、打得狠……挑适合自己的吧！"
				}
			]
		},
		"bye": {
			"lines": [
				{
					"text": "冷了就回来烤火！"
				}
			]
		}
	}
}
