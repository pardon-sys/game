{
	"name": "庆功宴的广场",
	"entries": [
		{
			"node": "wall"
		}
	],
	"nodes": {
		"wall": {
			"lines": [
				{
					"text": "（补了一半的城墙。下半截是新砌的砖，颜色浅浅的；上半截还搭着脚手架，脚手架上挂着一盏笑声灯笼）",
					"speaker": ""
				}
			]
		},
		"totem": {
			"lines": [
				{
					"text": "（修好的狂欢图腾柱。裂缝用木板缠了一圈又一圈，三张笑脸又端端正正地叠在一起了）",
					"speaker": ""
				},
				{
					"text": "（底下摆着一圈小灯笼。……柱子里面，好像有一点暖暖的光在跳）",
					"speaker": ""
				}
			]
		},
		"tent": {
			"lines": [
				{
					"text": "（打满补丁的帐篷。攻防战那几天，这里是伤员的帐篷——现在门帘卷起来了，里面堆着庆功宴的酒桶）",
					"speaker": ""
				}
			]
		},
		"lumber": {
			"lines": [
				{
					"text": "（明天补墙要用的木料。上面坐着两个偷懒的保卫队员，正在分一块饼干）",
					"speaker": ""
				}
			]
		},
		"ice_sheep": {
			"lines": [
				{
					"text": "（冰雕：蘑菇羊。蘑菇伞上的白点，是蓝色公主一个一个点出来的）",
					"speaker": ""
				}
			]
		},
		"ice_lantern": {
			"lines": [
				{
					"text": "（冰雕：一盏笑脸灯笼。篝火的光照进去，整盏灯都在发亮）",
					"speaker": ""
				}
			]
		},
		"ice_girls": {
			"lines": [
				{
					"text": "（冰雕：手拉手的两个小女孩，一个长卷发，一个短头发）",
					"speaker": ""
				},
				{
					"text": "……这个，是谁刻的？",
					"speaker": "公主",
					"emotion": "surprise"
				},
				{
					"text": "……",
					"speaker": "蓝色的公主"
				}
			]
		},
		"fish_basin": {
			"lines": [
				{
					"text": "（足疗鱼的木盆，从小汤姆的摊子搬到了篝火边。好几个镇民正坐在盆边，把脚伸进去泡）",
					"speaker": ""
				},
				{
					"text": "（……其中一条鱼，一直游到盆边，盯着你的脚看）",
					"speaker": ""
				}
			]
		}
	}
}
