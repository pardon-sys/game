{
	"name": "骑士",
	"npc": "knight",
	"entries": [
		{
			"node": "cell"
		}
	],
	"nodes": {
		"cell": {
			"lines": [
				{
					"text": "……你来干什么。"
				},
				{
					"text": "我……我想知道那天晚上到底发生了什么。",
					"speaker": "公主",
					"emotion": "sad"
				}
			],
			"next": "ask"
		},
		"ask": {
			"prompt": "问他什么？",
			"choices": [
				{
					"text": "那天晚上，你看见了什么？",
					"next": "night",
					"return": true,
					"if": {
						"not": "knight_asked_night"
					}
				},
				{
					"text": "王国……是怎么没的？",
					"next": "fall",
					"return": true,
					"if": {
						"not": "knight_asked_fall"
					}
				},
				{
					"text": "你为什么说是我？",
					"next": "why",
					"return": true,
					"if": {
						"not": "knight_asked_why"
					}
				},
				{
					"text": "（听到身后有脚步声）",
					"next": "blue",
					"if": {
						"flag": [
							"knight_asked_night",
							"knight_asked_fall",
							"knight_asked_why"
						]
					}
				}
			]
		},
		"night": {
			"lines": [
				{
					"text": "……那天夜里，王城的钟敲了十三下。"
				},
				{
					"text": "十三下？钟不是只敲十二下吗？",
					"speaker": "公主",
					"emotion": "surprise"
				},
				{
					"text": "……所以我才抬头看。"
				},
				{
					"text": "钟楼上站着殿下。……广场上，也站着殿下。"
				},
				{
					"text": "……两个？",
					"speaker": "公主",
					"emotion": "surprise"
				},
				{
					"text": "两个。一模一样的脸，一模一样的裙子。……两个，都在笑。"
				},
				{
					"text": "……我分不清。……到现在都分不清。"
				}
			],
			"set": {
				"flags": [
					"knight_asked_night"
				]
			}
		},
		"fall": {
			"lines": [
				{
					"text": "……从城堡底下，涌出来一只怪物。"
				},
				{
					"text": "它有一千只手。……全城的人，都被它挠着，笑到停不下来。"
				},
				{
					"text": "笑到……再也站不起来。"
				},
				{
					"text": "一千只手……",
					"speaker": "公主",
					"emotion": "surprise"
				},
				{
					"text": "……它笑起来的声音。"
				},
				{
					"text": "……和你，一模一样。"
				},
				{
					"text": "……！",
					"speaker": "公主",
					"emotion": "surprise"
				}
			],
			"set": {
				"flags": [
					"knight_asked_fall"
				]
			}
		},
		"why": {
			"lines": [
				{
					"text": "……城堡底下的封印。只有王族的手，才打得开。"
				},
				{
					"text": "我赶到的时候，封印已经开了。……站在封印前面的，是你。"
				},
				{
					"text": "你身后，还站着一个披斗篷的影子。……走路没有声音。"
				},
				{
					"text": "……斗篷的影子……",
					"speaker": "公主",
					"emotion": "surprise"
				},
				{
					"text": "……你转过头来看我。你在笑。"
				},
				{
					"text": "我、我不记得……我真的什么都不记得……",
					"speaker": "公主",
					"emotion": "sad"
				},
				{
					"text": "……那就去问那个影子吧。……如果你找得到它。"
				}
			],
			"set": {
				"flags": [
					"knight_asked_why"
				]
			}
		},
		"blue": {
			"lines": [
				{
					"text": "（蓝色公主从她身后的阴影里走了出来。火把的光落在她脸上）",
					"speaker": ""
				},
				{
					"text": "……",
					"speaker": "蓝色的公主"
				},
				{
					"text": "（骑士猛地站了起来，铁链「哗啦」一响）",
					"speaker": ""
				},
				{
					"text": "……殿下？"
				},
				{
					"text": "（他单膝跪了下去，跪在栏杆后面，低下了头）",
					"speaker": ""
				},
				{
					"text": "……殿下。您……您还……"
				},
				{
					"text": "……",
					"speaker": "蓝色的公主"
				},
				{
					"text": "（他抬起头，隔着面罩看了她很久。然后，慢慢地站了起来）",
					"speaker": ""
				},
				{
					"text": "……不。……头发不对。"
				},
				{
					"text": "……认错了。……抱歉。"
				},
				{
					"text": "……",
					"speaker": "蓝色的公主"
				},
				{
					"text": "（他看着蓝色公主时，声音放得很轻；转过头看向粉色公主时，又冷了下去）",
					"speaker": ""
				}
			]
		}
	}
}
