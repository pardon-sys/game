			"node": "d2_wait"
		},
		{
			"if": {
				"var": {
					"after_day": [
						"==",
						2
					]
				},
				"flag": [
					"after_done_d2_morning",
					"after_d2_fainted"
				]
			},
			"node": "d2_faint"
		},
		{
			"if": {
				"var": {
					"after_day": [
						"==",
						2
					]
