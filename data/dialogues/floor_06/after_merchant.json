				"flag": "after_done_d2_morning"
			},
			"node": "d2"
		},
		{
			"if": {
				"var": {
					"after_day": [
						"==",
						1
					]
				},
				"not": "after_done_d1_afternoon"
			},
			"node": "d1_wait"
		},
		{
			"if": {
				"var": {
					"after_day": [
						"==",
						1
					]
				}
			},
			"node": "d1"
		},
		{
			"node": "default"
		}
	],
	"nodes": {
		"d1": {
			"lines": [
				{
					"text": "哼，摊子的账，我一笔一笔记着呢！"
				},
				{
					"text": "……不过嘛，你拿锤子砸怪物的那几下，看着是挺解气的。"
				}
			]
		},
		"default": {
			"lines": [
				{
					"text": "今天的苹果……还是烂的。"
				}
			]
		},
		"d1_wait": {
			"lines": [
				{
					"text": "哼，等着吧。我的摊子可不能白被踩烂。"
				}
			]
		},
		"d2_wait": {
			"lines": [
				{
					"text": "嘿，今天可有好戏看了！我把摊子都挪到广场边上了。"
				}
			]
		},
		"d2": {
			"lines": [
				{
					"text": "哈哈，那几声笑得可真响！……不过你也算是挺住了，佩服佩服。"
				}
			]
		},
		"d2_faint": {
			"lines": [
				{
					"text": "笑晕过去了？……咳，那、那我摊子的账，就先少记一笔吧。"
				}
			]
		},
		"errand_apples": {
			"lines": [
				{
					"text": "哎哟哟——刚进的一筐苹果，被搬木料的车一撞，滚了一地！"
				},
				{
					"text": "你手脚快，帮我捡回来？四十秒，捡齐十个！"
				},
				{
					"text": "对了，有几个滚到了那种开粉花的怪草旁边……那草会缠人，小心点。"
				}
			],
			"prompt": "帮忙捡苹果？",
			"choices": [
				{
					"text": "好，计时开始！",
					"next": "errand_apples_accept"
				},
				{
					"text": "等一下再说",
					"next": ""
				}
			]
		},
		"errand_apples_accept": {
			"lines": [
				{
					"text": "预备——开始！"
				}
			],
			"set": {
				"vars": {
					"errand_req": "apples"
				},
				"call": "errand_start"
			}
		},
		"errand_apples_active": {
			"lines": [
				{
					"text": "快快快！还有好几个没捡！"
				}
			]
		},
		"errand_apples_done": {
			"lines": [
				{
					"text": "一个都没少，好！这个账我给你记一笔。"
				},
				{
					"text": "……摊子被踩烂的那笔，另算。"
				}
			]
		}
	},
	"npc": "merchant"
}
