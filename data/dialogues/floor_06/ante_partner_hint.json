		"pal0_p": {
			"lines": [
				{
					"text": "画像最后说的那句……「你不是她」……是什么意思呢？",
					"speaker": "公主"
				}
			]
		},
		"pal0_b": {
			"lines": [
				{
					"text": "……………不知道。……别想了。",
					"speaker": "蓝色的公主"
				}
			]
		},
		"pal1_p": {
			"lines": [
				{
					"text": "三个人偶说的都不一样……那天晚上到底发生了什么呢？",
					"speaker": "公主"
				}
			]
		},
		"pal1_b": {
			"lines": [
				{
					"text": "……谁都没有说错。……也许，大家看到的，都只是一部分。",
					"speaker": "蓝色的公主"
				}
			]
		},
		"pal2_p": {
			"lines": [
				{
					"text": "后花园的秋千……板子上的星星和雪花，好像在哪见过。",
					"speaker": "公主"
				}
			]
		},
		"pal2_b": {
			"lines": [
				{
					"text": "……秋千。……我好像，荡过。……不记得了。",
					"speaker": "蓝色的公主"
				}
			]
		},
		"pal3_p": {
			"lines": [
				{
					"text": "宝库里只有一束干掉的铃兰……陛下一定很喜欢那两个小不点吧。",
					"speaker": "公主"
				}
			]
		},
		"pal3_b": {
			"lines": [
				{
					"text": "……「两个小不点」。……卡片上的字，很温柔。",
					"speaker": "蓝色的公主"
				}
			]
		},
		"pal4_p": {
			"lines": [
				{
					"text": "钟敲了十三下以后，北边的门就开了……那天晚上，也是这样吗？",
					"speaker": "公主"
				}
			]
		},
		"pal4_b": {
			"lines": [
				{
					"text": "……十三下。……那个声音，我好像听过。",
					"speaker": "蓝色的公主"
				}
			]
		},
		"pal5_p": {
			"lines": [
				{
					"text": "这里以前一定很热闹吧……地上的笑脸地砖，墙上的画，都好像在等人回来。",
					"speaker": "公主"
				}
			]
		},
		"pal5_b": {
			"lines": [
				{
					"text": "……这里，很安静。……太安静了。像是在等谁。",
					"speaker": "蓝色的公主"
				}
			]
		},
