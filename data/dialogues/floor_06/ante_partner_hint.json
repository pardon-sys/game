		"chat0_p": {
			"lines": [
				{
					"text": "我还好！就是脚底还有点痒……刚才那些机关太坏了！",
					"speaker": "公主"
				}
			]
		},
		"chat0_b": {
			"lines": [
				{
					"text": "……还好。……你呢，别逞强。",
					"speaker": "蓝色的公主"
				}
			]
		},
		"chat1_p": {
			"lines": [
				{
					"text": "肚子饿了……厨房的蛋糕还能吃吗？",
					"speaker": "公主"
				}
			]
		},
		"chat1_b": {
			"lines": [
				{
					"text": "……那些人偶。……下次再挠，就冻住它们。",
					"speaker": "蓝色的公主"
				}
			]
		},
		"chat2_p": {
			"lines": [
				{
					"text": "你刚才是不是偷偷笑了？我听到了哦。",
					"speaker": "公主"
				}
			]
		},
		"chat2_b": {
			"lines": [
				{
					"text": "……没有笑。……你听错了。",
					"speaker": "蓝色的公主"
				}
			]
		},
		"chat3_p": {
			"lines": [
				{
					"text": "这里的人偶都好可爱……就是太喜欢挠人了。",
					"speaker": "公主"
				}
			]
		},
		"chat3_b": {
			"lines": [
				{
					"text": "……累了就说。……我背你。……开玩笑的。",
					"speaker": "蓝色的公主"
				}
			]
		},
