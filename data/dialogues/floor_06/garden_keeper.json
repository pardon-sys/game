			"lines": [
				{
					"text": "（花坛边上，一个戴着雏菊帽子的小花精人偶正对着一朵蔫掉的郁金香叹气）",
					"speaker": ""
				},
				{
					"text": "……蔫了，全都蔫了！……要浇花！要浇花！",
					"speaker": "花园小店主"
				},
				{
					"text": "可是我的小水壶……被厨房的人拿去装汤了！我、我不敢去厨房，厨师长好凶的！",
					"speaker": "花园小店主"
				},
				{
					"text": "……厨房。……水槽那边，也许有。",
					"speaker": "蓝色的公主"
				}
			],
			"set": {
				"flags": [
					"palace_keeper_asked"
				]
			}
		},
		"wait": {
			"lines": [
				{
					"text": "小水壶！小水壶在厨房！拜托啦！",
					"speaker": "花园小店主"
				}
			]
		},
		"water": {
			"lines": [
				{
					"text": "啊——！我的小水壶！",
					"speaker": "花园小店主"
				},
