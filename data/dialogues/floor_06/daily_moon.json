	"nodes": {
		"default": {
			"lines": [
				{
					"text": "（钟楼顶的栏杆边，并排摆着三把椅子：一把大的，两把小的。中间立着一架小小的铜望远镜）",
					"speaker": ""
				},
				{
					"text": "（大椅子上压着一张纸）「看月亮计划」",
					"speaker": ""
				},
				{
					"text": "「一、带毯子。怕冷的那个，带两条。」",
					"speaker": ""
				},
				{
					"text": "「二、带点心。不许在钟楼上吃蛋糕。……好吧，可以吃一块。」",
					"speaker": ""
				},
				{
					"text": "「三、讲月亮上的兔子的故事。结局要笑着。」",
					"speaker": ""
				},
				{
					"text": "「日期：下个月圆的那天。」",
					"speaker": ""
				},
				{
					"text": "……下个月圆的那天。",
					"speaker": "公主",
					"emotion": "sad"
				},
				{
					"text": "……月亮，已经圆过很多次了。",
					"speaker": "蓝色的公主"
				}
			],
			"set": {
				"flags": [
					"palace_daily_moon"
				]
			}
		},
