	"nodes": {
		"d1": {
			"lines": [
				{
					"text": "明天要光着脚坐一上午呢……今晚好好泡个脚，把脚底泡软一点吧。"
				},
				{
					"text": "……泡软了不是更怕痒吗？",
					"speaker": "公主",
					"emotion": "surprise"
				},
				{
					"text": "啊。……说、说得也是。"
				}
			]
		},
		"default": {
			"lines": [
				{
					"text": "受伤的队员都好多了。谢谢关心。"
				}
			]
		},
		"d1_wait": {
			"lines": [
				{
					"text": "广场上人好多……您的脸色不太好，先喝口水吧。"
				}
			]
		},
		"d2_wait": {
			"lines": [
				{
					"text": "鞋子先放我这里保管。……示众完了来拿。"
				},
				{
					"text": "……为什么连鞋都要收走啊……",
					"speaker": "公主",
					"emotion": "sad"
				}
			]
		},
		"d2": {
			"lines": [
				{
					"text": "鞋子拿好。……脚底红红的，回去用凉水敷一下吧。"
				}
			]
		},
		"d2_faint": {
			"lines": [
				{
					"text": "您醒了？鞋子刚才蓝色的那位来拿走了。……她好像很担心您。"
				}
			]
		},
		"errand_goats": {
			"lines": [
				{
					"text": "……那个。羊圈的门闩松了，五只蘑菇羊全跑出去了。"
				},
				{
					"text": "帮我把它们赶回来好吗？……我会跟队长说，给你记三个工时。"
				}
			],
			"prompt": "帮女仆赶羊？",
			"choices": [
				{
					"text": "好，交给我",
					"next": "errand_goats_accept"
				},
				{
					"text": "等一下再说",
					"next": ""
				}
			]
		},
		"errand_goats_accept": {
			"lines": [
				{
					"text": "谢谢。……盐块给你。"
				}
			],
			"set": {
				"vars": {
					"errand_req": "goats"
				},
				"call": "errand_start"
			}
		},
		"errand_goats_active": {
			"lines": [
				{
					"text": "……慢慢走。别跑，也别停。"
				}
			]
		},
		"errand_goats_done": {
			"lines": [
				{
					"text": "羊们今天都很乖。……它们好像挺喜欢你的。"
				},
				{
					"text": "……我一点都不想被它们喜欢。",
					"speaker": "公主",
					"emotion": "sad"
				}
			]
		},
		"errand_shearing": {
			"lines": [
				{
					"text": "上次赶回来的羊都好好的。今天帮咕咕梳结、剪毛，再把绒毛装袋吧？",
					"speaker": "女仆"
				},
				{
					"text": "……对了，咕咕剪毛时要舔着盐才乖。",
					"speaker": "女仆"
				}
			],
			"prompt": "帮女仆整理一只蘑菇羊？",
			"choices": [
				{
					"text": "好，只管这一只！",
					"next": "errand_shearing_accept"
				},
				{
					"text": "等一下再说",
					"next": ""
				}
			]
		},
		"errand_shearing_accept": {
			"lines": [
				{
					"text": "到东边羊圈门口来。垫子和盐罐都准备好了，中途歇一歇也能接着做。",
					"speaker": "女仆"
				}
			],
			"set": {
				"vars": {
					"errand_req": "shearing"
				},
				"call": "errand_start"
			}
		},
		"errand_shearing_active": {
			"lines": [
				{
					"text": "东边羊圈门口，咕咕在垫子边等你。……还有盐罐。",
					"speaker": "女仆"
				}
			]
		},
		"errand_shearing_done": {
			"lines": [
				{
					"text": "那三袋羊毛正好拿去补冬毯。咕咕这几天一见你就舔嘴唇呢。",
					"speaker": "女仆"
				},
				{
					"text": "让它舔盐砖去！",
					"speaker": "公主",
					"emotion": "angry"
				}
			]
		}
	},
	"npc": "maid"
}
