				{
					"node": "bed_day"
				}
			]
		},
		"bed_day": {
			"lines": [
				{
					"text": "带帷幔的公主床，被子软乎乎的。现在还不困。",
					"speaker": "公主",
					"emotion": "happy"
				}
			]
		},
		"bed_not_yet": {
			"lines": [
				{
					"text": "……还睡不着。房间里好像还有什么在意的东西……",
					"speaker": "公主",
					"emotion": "shy"
				}
			]
		},
		"bed_sleep": {
			"lines": [
				{
					"text": "……呼啊。好困……今天就睡吧。",
					"speaker": "公主",
					"emotion": "shy"
				}
			],
			"set": {
				"call": "sleep"
			}
		},
		"wardrobe": {
			"lines": [
				{
					"text": "衣柜里挂着几件洗得干干净净的裙子……尺寸刚好是我的？她连这个都准备好了。",
					"speaker": "公主",
					"emotion": "surprise"
				}
			],
			"goto": [
				{
					"if": {
						"flag": "blue_is_hero"
					},
					"node": "wardrobe_as_blue"
				}
			]
		},
		"bookshelf": {
			"lines": [
				{
					"text": "《地下小镇的历史》《矿道安全守则》《保卫队训练手册》……还有一本《地面上的童话》。",
					"speaker": "公主"
				},
				{
					"text": "……童话书的书角都翻卷了。她经常看吧。",
					"speaker": "公主",
					"emotion": "shy"
				}
			],
			"goto": [
				{
					"if": {
						"flag": "blue_is_hero"
					},
					"node": "bookshelf_as_blue"
				}
			]
		},
		"dresser": {
			"lines": [
				{
					"text": "梳妆台的镜子擦得亮亮的。……头发乱糟糟的，今天被挠了好多次。",
					"speaker": "公主",
					"emotion": "shy"
				}
			],
			"goto": [
				{
					"if": {
						"flag": "blue_is_hero"
					},
					"node": "dresser_as_blue"
				}
			]
		},
		"tea": {
			"lines": [
				{
					"text": "小圆桌上放着还温热的茶和一碟饼干。",
					"speaker": "公主",
					"emotion": "happy"
				},
				{
					"text": "……好吃！她泡的茶，有一点点花香。",
					"speaker": "公主",
					"emotion": "happy"
				}
			],
			"goto": [
				{
					"if": {
						"flag": "blue_is_hero"
					},
					"node": "tea_as_blue"
				}
			]
		},
		"plant": {
			"lines": [
				{
					"text": "盆栽的叶子绿油油的。地底下也能长得这么好啊。",
					"speaker": "公主"
				}
			],
			"goto": [
				{
					"if": {
						"flag": "blue_is_hero"
					},
					"node": "plant_as_blue"
				}
			]
		},
		"window": {
			"goto": [
				{
					"if": {
						"flag": "blue_is_hero"
					},
					"node": "window_as_blue"
				},
				{
					"if": {
						"flag": "night"
					},
					"node": "window_night"
				},
				{
					"node": "window_day"
				}
			]
		},
		"window_night": {
			"lines": [
				{
					"text": "窗外是小镇的夜色。……地底下也有月亮？原来是矿道顶上发光的石头。",
					"speaker": "公主",
					"emotion": "surprise"
				}
			]
		},
		"window_day": {
			"lines": [
				{
					"text": "窗外，小镇已经醒了。远处的矿道口有队员在站岗。",
					"speaker": "公主"
				}
			]
		},
		"painting": {
			"lines": [
				{
					"text": "画里是一片开满花的草地，天空蓝蓝的。……是地面上的风景。",
					"speaker": "公主",
					"emotion": "sad"
				}
			],
			"goto": [
				{
					"if": {
						"flag": "blue_is_hero"
					},
					"node": "painting_as_blue"
				}
			]
		},
		"saddle": {
			"goto": [
				{
					"if": {
						"flag": "blue_is_hero"
					},
					"node": "saddle_as_blue"
				},
				{
					"if": {
						"flag": "f6_key"
					},
					"node": "saddle_after"
				}
			],
			"lines": [
				{
					"text": "……房间角落里，怎么会有一张骑马的凳子？凳面上全是刷毛……",
					"speaker": "公主",
					"emotion": "surprise"
				},
				{
					"text": "好像有点像训练营里的那个……只是坐一下的话，应该没关系吧？",
					"speaker": "公主",
					"emotion": "shy"
				}
			],
			"theater": "f6_house_saddle",
			"next": "saddle_blue"
		},
		"saddle_blue": {
			"cutscene": "f6_blue_quiet",
			"perform_before": true,
			"set": {
				"give_item": {
					"mystery_key": 1
				},
				"flags": [
					"f6_key"
				]
			},
			"lines": [
				{
					"text": "（获得了「神秘的钥匙」）",
					"speaker": ""
				}
			]
		},
		"saddle_after": {
			"lines": [
				{
					"text": "……再也不坐了。绝对不坐了。",
					"speaker": "公主",
					"emotion": "angry"
				}
			]
		},
		"bed_as_blue": {
			"lines": [
				{
					"text": "……她睡过的床。被子没叠。",
					"speaker": "蓝色的公主"
				},
				{
					"text": "……枕头上还有一根粉色的头发。",
					"speaker": "蓝色的公主"
				}
			]
		},
		"wardrobe_as_blue": {
			"lines": [
				{
					"text": "……给她准备的裙子。只穿了一件。",
					"speaker": "蓝色的公主"
				}
			]
		},
		"bookshelf_as_blue": {
			"lines": [
				{
					"text": "……《地面上的童话》不在书架上。",
					"speaker": "蓝色的公主"
				},
				{
					"text": "……她带走了。",
					"speaker": "蓝色的公主"
				}
			]
		},
		"dresser_as_blue": {
			"lines": [
				{
					"text": "……镜子里只有我。",
					"speaker": "蓝色的公主"
				}
			]
		},
		"tea_as_blue": {
			"lines": [
				{
					"text": "……茶凉了。",
					"speaker": "蓝色的公主"
				},
				{
					"text": "……她说过，很好喝。",
					"speaker": "蓝色的公主"
				}
			]
		},
		"plant_as_blue": {
			"lines": [
				{
					"text": "……要记得浇水。",
					"speaker": "蓝色的公主"
				}
			]
		},
		"window_as_blue": {
			"lines": [
				{
					"text": "……矿道口的方向。",
					"speaker": "蓝色的公主"
				}
			]
		},
		"painting_as_blue": {
			"lines": [
				{
					"text": "……地面上的草地。……她想回去的地方。",
					"speaker": "蓝色的公主"
				}
			]
		},
		"saddle_as_blue": {
			"lines": [
				{
					"text": "……那张凳子。",
					"speaker": "蓝色的公主"
				},
				{
					"text": "……不坐。",
					"speaker": "蓝色的公主"
				}
			]
		}
	}
}
