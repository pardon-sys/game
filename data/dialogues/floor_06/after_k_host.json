	"nodes": {
		"t0": {
			"lines": [
				{
					"text": "……骑士？我小时候听人讲过骑士的故事。"
				},
				{
					"text": "可是没人讲完过。讲到一半，大家就不说了。"
				}
			]
		},
		"t1": {
			"lines": [
				{
					"text": "……嗯？哦，是你们呀。"
				},
				{
					"text": "篝火还在烧，可是今天大家都没心思跳舞。"
				}
			]
		},
		"kq_host_busy0": {
			"lines": [
				{
					"text": "彩带、点心、蜡烛……卖东西的大叔、女仆姐姐、工匠大叔那里都有。"
				},
				{
					"text": "借的时候……他们大概会要你帮个忙。"
				},
				{
					"text": "……别告诉他们是给我过生日哦。会不好意思的。"
				}
			],
			"prompt": "（没有名字的生日）",
