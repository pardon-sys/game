		"t0": {
			"lines": [
				{
					"text": "……那年暴雨，陛下撑着伞，在花园里站了一夜。",
					"speaker": "园丁（小画像）"
				},
				{
					"text": "……守的是小殿下们种的两棵小苗。",
					"speaker": "园丁（小画像）"
				},
				{
					"text": "……第二天她发烧了。……两棵苗，都活着。",
					"speaker": "园丁（小画像）"
				}
			]
		},
		"t1": {
			"lines": [
				{
					"text": "……陛下种花很笨，总是浇太多水。",
					"speaker": "园丁（小画像）"
				},
				{
					"text": "……她说：「花和孩子一样，多给一点爱，总不会错吧？」",
					"speaker": "园丁（小画像）"
				},
				{
					"text": "……花差点淹死。",
					"speaker": "园丁（小画像）"
				}
			]
		},
		"t2": {
			"lines": [
				{
					"text": "……陛下教小殿下们编花环。她编得又快又好。",
					"speaker": "园丁（小画像）"
				},
				{
					"text": "……可是每次，她都故意编错一个，让小殿下们笑她。",
					"speaker": "园丁（小画像）"
				}
			]
		},
		"t3": {
			"lines": [
				{
					"text": "……陛下最喜欢铃兰。",
					"speaker": "园丁（小画像）"
				},
				{
					"text": "……她说，铃兰的花像一串小铃铛。风一吹，就像在笑。",
					"speaker": "园丁（小画像）"
				}
			]
		},
		"t4": {
			"lines": [
				{
					"text": "……那天傍晚，陛下摘了三朵铃兰。",
					"speaker": "园丁（小画像）"
				},
				{
					"text": "……一朵别在自己头上。另外两朵，说是明天给小殿下们的。",
					"speaker": "园丁（小画像）"
				},
				{
					"text": "……那两朵，后来，夹在了那块铜牌后面。",
					"speaker": "园丁（小画像）"
				}
			]
		}
	}
}
