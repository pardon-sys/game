			"lines": [
				{
					"text": "（一页从日记本上撕下来的纸，字迹很温柔。署名是「乳母」）",
					"speaker": ""
				},
				{
					"text": "「……两个小殿下今天又抢同一个摇篮。怕黑的那个，夜里一定要抱着她的布兔子……」",
					"speaker": ""
				}
			],
			"set": {
				"flags": [
					"palace_diary_1"
				],
				"call": "palace_diary_page"
			},
			"next": "check"
