		},
		"t1": {
			"lines": [
				{
					"text": "……那个骑士，在工房里。"
				},
				{
					"text": "他醒来以后说的话——别往心里去。"
				},
				{
					"text": "……也别一个人去找他。"
				}
			]
		},
		"t2": {
			"lines": [
				{
					"text": "……来了。"
				},
				{
					"text": "地牢入口那边。别磨蹭。"
				}
			]
		},
		"kq_spear_busy": {
			"lines": [
				{
					"text": "训练室的门开着。……进去等我。"
