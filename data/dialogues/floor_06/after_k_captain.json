{
	"name": "保卫队队长",
	"npc": "captain",
	"entries": [
		{
			"if": {
				"eq": {
					"knight_step": 7
				},
				"not": "kq_active"
			},
			"node": "go"
		},
		{
			"if": {
				"flag": "kq_spear_active",
				"eq": {
					"kq_spear_stage": 0
				}
			},
			"node": "kq_spear_busy0"
		},
		{
			"if": {
				"flag": "kq_spear_active",
				"eq": {
					"kq_spear_stage": 1
				}
			},
			"node": "kq_spear_busy1"
		},
		{
			"if": {
				"flag": "kq_spear_active",
				"eq": {
					"kq_spear_stage": 2
				}
			},
			"node": "kq_spear_busy2"
		},
		{
			"if": {
				"flag": "kq_spear_active"
			},
			"node": "kq_spear_busy"
		},
		{
			"if": {
				"flag": "kq_spear_open"
			},
			"node": "kq_spear_offer"
		},
		{
			"if": {
				"var": {
					"knight_step": [
						">=",
						1
					]
				}
			},
			"node": "t0"
		},
		{
			"node": "t1"
		}
	],
	"nodes": {
		"t0": {
			"lines": [
				{
					"text": "……那个骑士，在工房里。"
				},
				{
					"text": "他醒来以后说的话——别往心里去。"
				},
				{
					"text": "……也别一个人去找他。"
				}
			]
		},
		"t1": {
			"lines": [
				{
					"text": "……来了。"
				},
				{
					"text": "地牢入口那边。别磨蹭。"
				}
			]
		},
		"go": {
			"lines": [
				{
					"text": "……你们来了。脸色不太好。"
				},
				{
					"text": "昨晚？……说吧。"
				},
				{
					"text": "地牢里那个骑士……他不是坏人。他身上的手印，是从别的地方带来的诅咒。",
					"speaker": "公主",
					"emotion": "sad"
				},
				{
					"text": "……他一直在喊「殿下」。……喊了一整夜。",
					"speaker": "蓝色的公主"
				},
				{
					"text": "……"
				},
				{
					"text": "我知道。……我在下面守了一夜，铁链一直在响。"
				},
				{
					"text": "我本来想，等他安静下来再——"
				}
			],
			"set": {
				"call": "knight_go"
			}
		},
		"kq_spear_busy0": {
			"lines": [
				{
					"text": "训练室的门开着。……进去等我。"
				},
				{
					"text": "……看矛尖。别看我。"
				}
			],
			"prompt": "（队长的旧剑术）",
			"choices": [
				{
					"text": "知道了"
				},
				{
					"text": "（先放一放）",
					"set": {
						"vars": {
							"kq_req": "spear"
						},
						"call": "kq_abandon"
					}
				}
			]
		},
		"kq_spear_busy1": {
			"lines": [
				{
					"text": "南边城墙下面有梯子。我在上面等。"
				},
				{
					"text": "……房檐上有手印。走路看脚下的影子。"
				}
			],
			"prompt": "（队长的旧剑术）",
			"choices": [
				{
					"text": "知道了"
				},
				{
					"text": "（先放一放）",
					"set": {
						"vars": {
							"kq_req": "spear"
						},
						"call": "kq_abandon"
					}
				}
			]
		},
		"kq_spear_busy2": {
			"lines": [
				{
					"text": "……两个人一起来。"
				},
				{
					"text": "我不会笑的。……你们最好也别笑。"
				}
			],
			"prompt": "（队长的旧剑术）",
			"choices": [
				{
					"text": "知道了"
				},
				{
					"text": "（先放一放）",
					"set": {
						"vars": {
							"kq_req": "spear"
						},
						"call": "kq_abandon"
					}
				}
			]
		},
		"kq_spear_busy": {
			"lines": [
				{
					"text": "训练室的门开着。……进去等我。"
				}
			],
			"prompt": "（队长的旧剑术）",
			"choices": [
				{
					"text": "知道了"
				},
				{
					"text": "（先放一放）",
					"set": {
						"vars": {
							"kq_req": "spear"
						},
						"call": "kq_abandon"
					}
				}
			]
		},
		"kq_spear_offer": {
			"lines": [
				{
					"text": "……你。过来。"
				},
				{
					"text": "那个骑士的起手式……矛尖压低，左肩在前。"
				},
				{
					"text": "他被抬出来的时候，手还是那个架势。……昏过去了，都没松。"
				},
				{
					"text": "……我见过这个架势。可是想不起来，在哪见过。"
				},
				{
					"text": "……我想再练一遍。缺个靶子。"
				},
				{
					"text": "靶、靶子？",
					"speaker": "公主",
					"emotion": "surprise"
				},
				{
					"text": "木矛，包了布。打中了不疼。……只是会挨我的老办法。"
				}
			],
			"prompt": "去训练室陪队长练剑？",
			"choices": [
				{
					"text": "……好吧！",
					"set": {
						"vars": {
							"kq_req": "spear"
						},
						"call": "kq_start"
					}
				},
				{
					"text": "下次吧"
				}
			]
		}
	}
}
