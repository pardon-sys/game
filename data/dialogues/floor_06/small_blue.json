		"t0": {
			"lines": [
				{
					"text": "……朝会上，两位大臣吵了一上午。",
					"speaker": "侍从长（小画像）"
				},
				{
					"text": "……陛下听完，说：「那就请两位比赛，谁先笑，谁输。」",
					"speaker": "侍从长（小画像）"
				},
				{
					"text": "……两个人瞪了半天，一起笑了。事情就这么定了。",
					"speaker": "侍从长（小画像）"
				}
			]
		},
		"t1": {
			"lines": [
				{
					"text": "……陛下从来不发脾气。",
					"speaker": "侍从长（小画像）"
				},
				{
					"text": "……可是她认真起来的时候，整个王座间都很安静。",
					"speaker": "侍从长（小画像）"
				},
				{
					"text": "……闹饥荒的那年，她把自己的首饰一件一件卖掉了。一句话也没有多说。",
					"speaker": "侍从长（小画像）"
				}
			]
		},
		"t2": {
			"lines": [
				{
					"text": "……我负责记朝会延误的理由。",
					"speaker": "侍从长（小画像）"
				},
				{
					"text": "……十条里，九条是陛下被挠得说不出话。",
					"speaker": "侍从长（小画像）"
				},
				{
					"text": "……剩下一条，是她去给生病的小殿下熬姜汤。",
					"speaker": "侍从长（小画像）"
				}
			]
		},
		"t3": {
			"lines": [
				{
					"text": "……陛下说：「一个国家，要先学会笑，才学得会勇敢。」",
					"speaker": "侍从长（小画像）"
				},
				{
					"text": "……我当时不懂。……后来，懂了。",
					"speaker": "侍从长（小画像）"
				}
			]
		},
		"t4": {
			"lines": [
				{
					"text": "……陛下每次下朝，都要先绕到婴儿房，看一眼。",
					"speaker": "侍从长（小画像）"
				},
				{
					"text": "……我说，陛下，大臣们还在等。",
					"speaker": "侍从长（小画像）"
				},
				{
					"text": "……她说：「让他们等。……她们长大，可不会等我。」",
					"speaker": "侍从长（小画像）"
				}
			]
		}
	}
}
